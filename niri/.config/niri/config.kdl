// niri — ana config dosyası
//
// Ayarlar konularına göre ayrı dosyalarda duruyor; bu dosya onları sırayla dahil eder.
// "include" konumsaldır: sonra dahil edilen dosya, öncekinin aynı ayarını ezer.
//
//   input.kdl    touchpad, fare, klavye (düzen sistemden gelir)
//   ~/.config/niri/local.kdl  BU BİLGİSAYARA ÖZEL: laptop ekranının ölçeği, klavye düzeni,
//                imleç teması. Repoda değil; install.sh şablondan (examples/niri-local.kdl) bir kez
//                oluşturur, git pull dokunmaz.
//   ~/.local/state/settings/niri.kdl  touchpad, klavye — Settings uygulaması üretir (Super+S)
//   ~/.local/state/displays/niri.kdl  harici monitörlerin yeri — `displays` komutu üretir (Super+P)
//   layout.kdl   boşluklar, sütun genişlikleri, odak halkası
//   binds.kdl    kısayollar
//   rules.kdl    pencere kuralları (köşeler, gölgeler, yüzen pencereler)
//   animations.kdl  animasyonlar
//   ~/.local/state/theme/niri.kdl  renkler — `theme` komutu üretir (en sonda, öncekileri ezer)
//
// Kaydettiğin her değişiklik anında uygulanır. Hata kontrolü için: niri validate

include "input.kdl"
include optional=true "~/.config/niri/local.kdl"
include optional=true "~/.local/state/settings/niri.kdl"
include optional=true "~/.local/state/displays/niri.kdl"
include "layout.kdl"
include "binds.kdl"
include "rules.kdl"
include "animations.kdl"
include optional=true "~/.local/state/theme/niri.kdl"

// Uygulamalardan kendi başlık çubuklarını çizmemelerini iste (sade görünüm).
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Açılışta kısayol listesini gösterme. Listeyi açmak için: Super+Shift+ß (Super+?)
hotkey-overlay {
    skip-at-startup
}

// İmleç teması bilgisayara özel: ~/.config/niri/local.kdl
cursor {
    xcursor-size 24
    hide-when-typing
}

// Yalnızca niri'nin başlattığı programlara uygulanır; KDE oturumunu etkilemez.
environment {
    // KDE uygulamaları (Dolphin, Okular…) niri'de de Breeze simgelerini ve renklerini kullansın.
    QT_QPA_PLATFORMTHEME "kde"
}
