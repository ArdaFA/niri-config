// Kısayollar.
//
// "Mod" = Super (Windows) tuşu. niri KDE içinde pencere olarak açıkken Mod = Alt olur.
// Almanca klavyede AltGr/Shift isteyen [ ] / = tuşları bilerek kullanılmadı.
// Ekranda kısayol listesi: Super+Shift+ß (yani Super+?)
//
// Kalıp:  Mod+Ctrl  = taşı,  Mod+Shift = monitör / dikey,  Mod+Shift+Ctrl = monitöre taşı

binds {
    // ── Genel ────────────────────────────────────────────────────────────
    Mod+Shift+ssharp hotkey-overlay-title="Show this list" { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal (foot)" { spawn "foot"; }
    // Arama: uygulama, pencere, dosya, ayar, hesap, emoji (bin/.local/bin/launcher).
    // Arka planda bekleyen pencereye sinyal gönderir; servis çalışmıyorsa fuzzel açılır.
    Mod+D hotkey-overlay-title="Search: apps, windows, files, settings" { spawn-sh "systemctl --user kill --kill-whom=main --signal=USR1 launcher.service 2>/dev/null || exec fuzzel"; }
    Mod+Space { spawn-sh "systemctl --user kill --kill-whom=main --signal=USR1 launcher.service 2>/dev/null || exec fuzzel"; }
    Mod+S hotkey-overlay-title="Settings" { spawn-sh "~/.local/bin/settings"; }
    Mod+Shift+T hotkey-overlay-title="Pick a color theme" { spawn-sh "~/.local/bin/theme pick"; }
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn-sh "~/.local/bin/lock-screen"; }
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Shift+E hotkey-overlay-title="Log out" { quit; }
    Mod+Shift+P hotkey-overlay-title="Turn off monitors" { power-off-monitors; }
    // Harici monitör laptopun neresinde (üst/alt/sol/sağ). Windows'taki "Project" kısayoluyla aynı tuş.
    Mod+P hotkey-overlay-title="Arrange monitors" { spawn-sh "~/.local/bin/displays pick"; }
    // Tam ekran bir uygulama (ör. sanal makine) kısayolları yakalarsa geri almak için.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── Odak: pencere / sütun ────────────────────────────────────────────
    // Sağ/sol son sütundan sonra yandaki monitöre geçer.
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-or-monitor-left; }
    Mod+L     { focus-column-or-monitor-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── Taşı: pencere / sütun ────────────────────────────────────────────
    // Sol/sağ: AUTO modunda odaktaki pencereyi yandaki sütundaki komşusuyla yer
    // değiştirir; FREE'de (ya da servis kapalıyken) sütunu taşır. layout-mode karar verir.
    // Yukarı/aşağı: pencereyi sütun içinde komşusuyla yer değiştirir (iki modda da).
    Mod+Ctrl+Left  hotkey-overlay-title="Swap / move window left" { spawn-sh "~/.local/bin/layout-mode move left"; }
    Mod+Ctrl+Right hotkey-overlay-title="Swap / move window right" { spawn-sh "~/.local/bin/layout-mode move right"; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { spawn-sh "~/.local/bin/layout-mode move left"; }
    Mod+Ctrl+L     { spawn-sh "~/.local/bin/layout-mode move right"; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ── Monitörler ───────────────────────────────────────────────────────
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+J     { focus-monitor-down; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    // ── Workspace'ler (dikey dizilir) ────────────────────────────────────
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Ctrl+Page_Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    { move-column-to-workspace-up; }
    Mod+Ctrl+U          { move-column-to-workspace-down; }
    Mod+Ctrl+I          { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+Tab             { focus-workspace-previous; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ── Fare tekerleği ───────────────────────────────────────────────────
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // ── Sütun ve pencere boyutu ──────────────────────────────────────────
    // Pencereyi soldaki/sağdaki sütuna kat ya da sütundan çıkar.
    Mod+Comma  { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    Mod+R       hotkey-overlay-title="Column width: 1/3 · 1/2 · 2/3" { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+F       hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }

    Mod+Minus       { set-column-width "-10%"; }
    Mod+Plus        { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Plus  { set-window-height "+10%"; }

    Mod+V       hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       hotkey-overlay-title="Toggle tabbed column" { toggle-column-tabbed-display; }

    // Düzen modu: AUTO (iki sütunlu otomatik ızgara) ↔ FREE (dizme durur, elle ayarla).
    // layout-mode servisi yapar; paneldeki AUTO/FREE etiketine tıklamak da aynı.
    Mod+T       hotkey-overlay-title="Layout mode: AUTO / FREE" { spawn-sh "~/.local/bin/layout-mode toggle"; }

    // ── Ekran görüntüsü (~/Pictures/Screenshots + panoya kopyalanır) ─────
    Print       hotkey-overlay-title="Screenshot (select area)" { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }
    // Alan seç, sonra swappy'de üstüne çiz (ok, kutu, yazı). Super+Print: son görüntüyü düzenle.
    Shift+Print hotkey-overlay-title="Screenshot and edit (swappy)" { spawn-sh "~/.local/bin/screenshot-edit"; }
    Mod+Alt+S   { spawn-sh "~/.local/bin/screenshot-edit"; }
    Mod+Print   hotkey-overlay-title="Edit last screenshot" { spawn-sh "~/.local/bin/screenshot-edit last"; }

    // ── Ekran kaydı (wf-recorder, ~/Videos/Recordings) ───────────────────
    // Bir daha basmak ya da paneldeki kırmızı REC'e tıklamak durdurur.
    Mod+Alt+R       hotkey-overlay-title="Record screen (start / stop)" { spawn-sh "~/.local/bin/screen-record toggle screen"; }
    Mod+Alt+Shift+R hotkey-overlay-title="Record an area (start / stop)" { spawn-sh "~/.local/bin/screen-record toggle region"; }

    // ── Bildirimler ve hızlı ayarlar (swaync) ────────────────────────────
    // Panel: hızlı ayarlar + bildirim geçmişi. Waybar'da VOL/NET/BAT ya da MSG'ye tıklamak da açar.
    Mod+N       hotkey-overlay-title="Quick settings & notifications" { spawn "swaync-client" "--toggle-panel" "--skip-wait"; }
    Mod+Shift+N hotkey-overlay-title="Hide notification popups" { spawn "swaync-client" "--hide-all" "--skip-wait"; }
    Mod+Ctrl+N  hotkey-overlay-title="Do not disturb on/off" { spawn "swaync-client" "--toggle-dnd" "--skip-wait"; }

    // ── Ses, medya, parlaklık (kilit ekranında da çalışır) ───────────────
    // osd scripti değeri değiştirir ve üst ortada kısa bir gösterge açar.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "~/.local/bin/osd volume up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "~/.local/bin/osd volume down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "~/.local/bin/osd volume mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "~/.local/bin/osd mic mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "~/.local/bin/osd brightness up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "~/.local/bin/osd brightness down"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    Mod+M hotkey-overlay-title="Media controls" { spawn-sh "~/.local/bin/media-popup"; }
}
