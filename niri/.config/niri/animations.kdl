// Animasyonlar: kısa ve sakin; hiçbiri sekmez (damping-ratio=1.0).
// Hepsini kapatmak için bloğun içine `off` yaz. Yavaşlatmak için: slowdown 2.0

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Config yeniden yüklendi bildirimi de sekmesin.
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }
}
