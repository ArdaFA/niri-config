// Pencere kuralları.
// Açık pencerelerin app-id ve başlıklarını görmek için: niri msg windows

// Tüm pencereler: hafif yuvarlak köşeler (Waybar, fuzzel, mako ile aynı 6 px).
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Yüzen pencereler zeminden ayrılsın diye yumuşak gölge.
window-rule {
    match is-floating=true
    shadow {
        on
    }
}

// Yönetici şifresi soran KDE polkit penceresi yüzen (floating) açılsın.
window-rule {
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    open-floating true
}

// Küçük ayar pencereleri (Waybar/tepsiden açılanlar) de yüzen açılsın:
// ses mikseri, ağ bağlantıları, Bluetooth, ayarlar (settings).
window-rule {
    match app-id=r#"^dotfiles\.settings$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"blueman-manager"#
    match app-id=r#"swappy"#
    open-floating true
}

// Medya kontrol kutusu (media-popup): gölge, köşeleri kutunun CSS'iyle aynı (16 px).
// Arkadaki saydam katmanın adı farklı (media-popup-backdrop), ona gölge düşmez.
layer-rule {
    match namespace="^media-popup$"
    shadow {
        on
    }
    geometry-corner-radius 16
}

// Terminal yarı saydam (foot.ini → alpha): arkasında duvar kağıdı bulanık görünsün.
// "xray": yalnızca duvar kağıdı görünür, altta kalan başka pencereler değil (ve ucuz:
// bulanıklık bir kez hesaplanır). Odak halkası pencerenin etrafında kalsın, arkasında değil.
window-rule {
    match app-id=r#"^foot(client)?$"#
    background-effect {
        blur true
    }
    draw-border-with-background false
}

// Resim içinde resim (tarayıcıda video PiP): sağ altta küçük yüzen pencere. Brave/Chromium
// başlığı "Picture in picture", Firefox'unki "Picture-in-Picture".
window-rule {
    match title=r#"^Picture[- ]in[- ][Pp]icture$"#
    open-floating true
    open-focused false
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

// Renk seçici Eyedropper küçük bir araç: yüzen açılsın.
window-rule {
    match app-id=r#"^com\.github\.finefindus\.eyedropper$"#
    open-floating true
}

// Ekran paylaşırken (toplantı, yayın) parola yöneticileri izleyenlere siyah görünür; ekranında
// sen normal görürsün. Ekran görüntüsünü (Print) etkilemez, yalnızca yayını.
window-rule {
    match app-id=r#"(?i)^(proton[- ]pass|org\.keepassxc\.keepassxc|bitwarden)$"#
    block-out-from "screencast"
}

// Aynı şekilde yayında gizli: arama penceresi (pano geçmişi, dosya adları, açık pencereler
// görünebilir), bildirimler ve bildirim paneli (mesaj içerikleri). Ekran paylaşılırken
// açılır bildirimler zaten bekletiliyor (bar-status privacy → QUIET).
layer-rule {
    match namespace="^launcher$"
    match namespace="^swaync-notification-window$"
    match namespace="^swaync-control-center$"
    block-out-from "screencast"
}
