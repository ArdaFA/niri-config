// Pencere kuralları.
// Açık pencerelerin app-id ve başlıklarını görmek için: niri msg windows

// Tüm pencereler: hafif yuvarlak köşeler (Waybar, fuzzel, mako ile aynı 6 px).
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

// Yüzen pencereler zeminden ayrılsın diye yumuşak gölge.
window-rule {
    match is-floating=true
    shadow {
        on
    }
}

// Yönetici şifresi soran KDE polkit penceresi yüzen (floating) açılsın.
window-rule {
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    open-floating true
}

// Küçük ayar pencereleri (Waybar/tepsiden açılanlar) de yüzen açılsın:
// ses mikseri, ağ bağlantıları, Bluetooth.
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"blueman-manager"#
    open-floating true
}
