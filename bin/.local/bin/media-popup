#!/usr/bin/env python3
"""media-popup — small media controls that drop down from the bar.

  media-popup               open (or close, if already open) in the top-right corner
  media-popup --at-pointer  open under the mouse pointer (Waybar: click on the media title)
  media-popup selftest      check the helper rules (check.sh)

Keys: Space play/pause · ←/→ seek 5 s · N next · P previous · Esc close.
"""
# Waybar'da medya başlığına tıklayınca açılan küçük kontrol kutusu ("ada").
# Hangi çalar: Waybar'ın medya modülüyle aynısı (playerctld'nin en son kullanılan çaları).
# Kapanır: dışarı tıklayınca, Esc, tekrar çalıştırınca ya da çalar kapanınca.
# Dışarı tıklamayı yakalamak için ekranı kaplayan saydam bir katman açılır (calendar-popup gibi);
# aynı katman fare imlecinin yerini de verir, kutu başlığın altında açılır.
# GTK3 + gtk-layer-shell; ek paket gerekmez. Renkler ~/.local/state/theme/panel.css'ten.
# Ekrana yazılan her şey İngilizce (arayüz kuralı); açıklamalar Türkçe.

import hashlib
import os
import signal
import sys
import threading
import urllib.parse
import urllib.request
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
PID_FILE = RUNTIME / "media-popup.pid"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "media-popup"

MPRIS = "org.mpris.MediaPlayer2"
PLAYER_IFACE = MPRIS + ".Player"
PLAYERCTLD = MPRIS + ".playerctld"
OBJ_PATH = "/org/mpris/MediaPlayer2"

WIDTH = 340          # kutunun genişliği (piksel)
ART = 56             # kapak resmi
MARGIN = 6           # ekran kenarı ve bar ile arası
SEEK_STEP = 5        # ←/→ kaç saniye sarar
POINTER_WAIT = 120   # --at-pointer: imlecin yeri için en fazla bu kadar ms beklenir
ART_MAX_BYTES = 8 * 1024 * 1024
ART_CACHE_FILES = 50   # indirilen kapaklardan en fazla bu kadarı saklanır

KEYS = {"Escape": "close", "q": "close", "space": "play_pause", "k": "play_pause",
        "Left": "back", "h": "back", "Right": "forward", "l": "forward",
        "n": "next", "p": "previous"}


# ── Saf yardımcılar (selftest bunları sınar) ──────────────────────────────

def fmt_time(us):
    """Mikrosaniye → 1:05 ya da 1:02:03."""
    s = max(0, int((us or 0) // 1_000_000))
    h, rest = divmod(s, 3600)
    m, s = divmod(rest, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def choose_player(names, recent, playing):
    """names: oturumdaki MPRIS adları · recent: playerctld'nin listesi (en yeni başta) ·
    playing: çalan çalarlar. Waybar'ın modülüyle aynı seçimi yapmak için önce playerctld."""
    players = [n for n in names if n.startswith(MPRIS + ".") and n != PLAYERCTLD]
    for name in recent:
        if name in players:
            return name
    for name in players:
        if name in playing:
            return name
    return players[0] if players else None


def island_left(pointer_x, width, output_width, margin=MARGIN):
    """Kutuyu imlecin altına ortalar, ekrandan taşırmaz."""
    left = int(pointer_x - width / 2)
    return max(margin, min(left, output_width - width - margin))


def art_source(url):
    """mpris:artUrl → ("file", yol) / ("http", url) / None."""
    if not url:
        return None
    if url.startswith("file://"):
        return ("file", urllib.parse.unquote(urllib.parse.urlparse(url).path))
    if url.startswith(("http://", "https://")):
        return ("http", url)
    return None


def track_info(md):
    """MPRIS Metadata sözlüğünden gösterilecek alanlar."""
    md = md or {}
    artists = md.get("xesam:artist") or []
    if isinstance(artists, str):
        artists = [artists]
    return {
        "title": md.get("xesam:title") or "Unknown title",
        "artist": ", ".join(a for a in artists if a) or md.get("xesam:album") or "",
        "length": int(md.get("mpris:length") or 0),
        "trackid": md.get("mpris:trackid"),
        "art": md.get("mpris:artUrl") or "",
    }


def selftest():
    cases = [
        (fmt_time(0), "0:00"), (fmt_time(65_000_000), "1:05"), (fmt_time(3_723_000_000), "1:02:03"),
        (fmt_time(None), "0:00"),
        (choose_player([PLAYERCTLD, MPRIS + ".a", MPRIS + ".b"], [MPRIS + ".b"], set()), MPRIS + ".b"),
        (choose_player([MPRIS + ".a", MPRIS + ".b"], [], {MPRIS + ".b"}), MPRIS + ".b"),
        (choose_player([MPRIS + ".a"], [MPRIS + ".gone"], set()), MPRIS + ".a"),
        (choose_player([PLAYERCTLD, "org.other"], [], set()), None),
        (island_left(800, 340, 1600), 630),
        (island_left(1590, 340, 1600), 1254),
        (island_left(10, 340, 1600), 6),
        (art_source("file:///tmp/a%20b.png"), ("file", "/tmp/a b.png")),
        (art_source("https://x/y.jpg"), ("http", "https://x/y.jpg")),
        (art_source(""), None), (art_source("data:abc"), None),
        (track_info({})["title"], "Unknown title"),
        (track_info({"xesam:artist": ["A", "B"], "mpris:length": 5})["artist"], "A, B"),
        (track_info({"xesam:artist": "A"})["artist"], "A"),
        (KEYS["space"], "play_pause"),
    ]
    bad = [(i, got, want) for i, (got, want) in enumerate(cases) if got != want]
    for i, got, want in bad:
        print(f"case {i}: got {got!r}, want {want!r}", file=sys.stderr)
    if bad:
        sys.exit(1)
    print(f"media-popup: {len(cases)} checks ok")


def already_open():
    """Açık bir kutu varsa kapatır ve True döndürür (aç/kapa davranışı)."""
    try:
        pid = int(PID_FILE.read_text())
        if b"media-popup" in Path(f"/proc/{pid}/cmdline").read_bytes():
            os.kill(pid, signal.SIGTERM)
            return True
    except (OSError, ValueError):
        pass
    return False


if __name__ == "__main__":
    if sys.argv[1:] == ["selftest"]:
        selftest()
        sys.exit(0)
    if already_open():
        sys.exit(0)   # açık kutu kapatıldı; GTK'yı hiç yüklemeden çık

# Katman penceresi yalnızca Wayland'de anlamlı; X11'e düşüp normal pencere açmasın.
os.environ["GDK_BACKEND"] = "wayland"

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("Pango", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

THEME_CSS = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "theme/panel.css"

