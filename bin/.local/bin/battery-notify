#!/usr/bin/python3
# battery-notify — pil azalınca bildirim gösterir (niri oturumu; KDE'de bunu Plasma yapıyor).
#
#   battery-notify            UPower'ı dinler (battery-notify.service)
#   battery-notify selftest   arayüzsüz testler (check.sh)
#
# Eşikler UPower'ın kendi uyarı seviyeleri (/etc/UPower/UPower.conf, Fedora'da %20 düşük,
# %5 kritik, %2'de sistem uyku/kapanma yapar). Böylece bildirim, sistemin kendi kararıyla aynı
# anda gelir. Tek bildirim var, seviye değişince yerine yenisi geçer; şarja takınca kapanır.
# Kritik bildirim kendiliğinden kaybolmaz (swaync: urgency critical).
# Test için: BATTERY_NOTIFY_BUS=session → UPower'ı oturum veri yolunda arar.

import os
import sys

UPOWER = "org.freedesktop.UPower"
DEVICE = "/org/freedesktop/UPower/devices/DisplayDevice"
NONE, LOW, CRITICAL, ACTION = 1, 3, 4, 5            # UPower WarningLevel
ACTIONS = {"PowerOff": "shut down", "Hibernate": "hibernate", "HybridSleep": "hibernate",
           "Suspend": "go to sleep", "Sleep": "go to sleep"}


def duration(seconds):
    minutes = round(seconds / 60)
    if minutes < 1:
        return ""
    if minutes < 60:
        return f"about {minutes} min"
    return f"about {minutes // 60} h {minutes % 60:02d} min"


def message(level, percentage, time_to_empty, action):
    """(başlık, metin, aciliyet 1/2, simge) ya da None (bildirim gerekmez)."""
    left = f"{round(percentage)}% left"
    remaining = duration(time_to_empty)
    verb = ACTIONS.get(action, "shut down")
    if level == LOW:
        return ("Battery low", left + (f" · {remaining}" if remaining else ""), 1,
                "battery-low-symbolic")
    if level == CRITICAL:
        return ("Battery critically low",
                f"{left}. Plug in the charger: the computer will {verb} soon.", 2,
                "battery-caution-symbolic")
    if level == ACTION:
        return ("Battery empty", f"The computer will {verb} now.", 2, "battery-empty-symbolic")
    return None


class Notifier:
    """Seviye geçişleri: yükselince bildir, NONE'a dönünce kapat, aynı seviyede sessiz kal."""

    def __init__(self, notify, close):
        self.notify, self.close = notify, close
        self.shown = NONE

    def update(self, level, percentage, time_to_empty, action):
        if level < LOW:
            if self.shown != NONE:
                self.close()
                self.shown = NONE
            return
        if level <= self.shown:
            return
        msg = message(level, percentage, time_to_empty, action)
        if msg:
            self.notify(*msg)
            self.shown = level


def selftest():
    calls = []
    n = Notifier(lambda *m: calls.append(("notify",) + m), lambda: calls.append(("close",)))
    n.update(NONE, 80, 9000, "PowerOff")
    n.update(LOW, 20, 3900, "PowerOff")
    n.update(LOW, 19, 3700, "PowerOff")          # aynı seviye: sessiz
    n.update(CRITICAL, 5, 600, "Sleep")
    n.update(LOW, 6, 700, "Sleep")               # geri düşüş (ölçüm oynadı): sessiz
    n.update(NONE, 6, 0, "Sleep")                # şarja takıldı
    n.update(NONE, 7, 0, "Sleep")
    n.update(CRITICAL, 4, 300, "Hibernate")      # şarjdan çıkınca doğrudan kritik
    kinds = [c[0] for c in calls]
    cases = [
        ("sequence", kinds, ["notify", "notify", "close", "notify"]),
        ("low text", calls[0][1:3], ("Battery low", "20% left · about 1 h 05 min")),
        ("critical text", calls[1][2], "5% left. Plug in the charger: the computer will go to sleep soon."),
        ("critical urgency", calls[1][3], 2),
        ("hibernate", "hibernate soon" in calls[3][2], True),
        ("no time", message(LOW, 19.6, 0, "")[1], "20% left"),
        ("short time", duration(1500), "about 25 min"),
        ("action", message(ACTION, 2, 60, "PowerOff")[1], "The computer will shut down now."),
    ]
    failed = [(name, got, want) for name, got, want in cases if got != want]
    for name, got, want in failed:
        print(f"FAIL {name}: got {got!r}, want {want!r}")
    if failed:
        sys.exit(1)
    print(f"battery-notify: {len(cases)} checks ok")


def main():
    from gi.repository import Gio, GLib

    system = os.environ.get("BATTERY_NOTIFY_BUS") != "session"
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM if system else Gio.BusType.SESSION)
    session = Gio.bus_get_sync(Gio.BusType.SESSION)
    device = Gio.DBusProxy.new_sync(bus, Gio.DBusProxyFlags.NONE, None, UPOWER, DEVICE,
                                    f"{UPOWER}.Device")
    notify_id = 0

    def critical_action():
        try:
            return bus.call_sync(UPOWER, "/org/freedesktop/UPower", UPOWER, "GetCriticalAction",
                                 None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 2000,
                                 None).unpack()[0]
        except GLib.Error:
            return ""

    def notify(summary, body, urgency, icon):
        nonlocal notify_id
        hints = {"urgency": GLib.Variant("y", urgency),
                 "category": GLib.Variant("s", "device.warning")}
        try:
            reply = session.call_sync(
                "org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                "org.freedesktop.Notifications", "Notify",
                GLib.Variant("(susssasa{sv}i)", ("Battery", notify_id, icon, summary, body, [],
                                                 hints, -1)),
                GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 5000, None)
            notify_id = reply.unpack()[0]
        except GLib.Error as e:
            print(f"battery-notify: {e.message}", file=sys.stderr)

    def close():
        nonlocal notify_id
        if notify_id:
            try:
                session.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                                  "org.freedesktop.Notifications", "CloseNotification",
                                  GLib.Variant("(u)", (notify_id,)), None, Gio.DBusCallFlags.NONE,
                                  5000, None)
            except GLib.Error:
                pass
            notify_id = 0

    notifier = Notifier(notify, close)

    def prop(name, default):
        value = device.get_cached_property(name)
        return value.unpack() if value is not None else default

    def changed(*_):
        level = prop("WarningLevel", NONE)
        action = critical_action() if level >= CRITICAL else ""
        notifier.update(level, prop("Percentage", 0.0), prop("TimeToEmpty", 0), action)

    device.connect("g-properties-changed", changed)
    changed()
    GLib.MainLoop().run()


if __name__ == "__main__":
    if sys.argv[1:] == ["selftest"]:
        selftest()
    elif sys.argv[1:]:
        sys.exit("usage: battery-notify [selftest]")
    else:
        main()
