      "application/vnd.rar", "application/x-rar")),
    ("mail", "Email", "mailto: links", ("x-scheme-handler/mailto",)),
)
MIMEAPPS_HEADER = ("# niri oturumunun varsayılan uygulamaları. Ayarlar → Default apps yazar; elle de\n"
                   "# düzenlenebilir. KDE bu dosyayı okumaz (o ~/.config/mimeapps.list'e bakar).\n")


# ── Ayar dosyaları (arayüzden bağımsız; selftest bunları sınar) ───────────

def read_json(path):
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def write_atomic(path, text):
    """İçerik aynıysa dokunmaz (niri boşuna yeniden yüklemesin). Değiştiyse True."""
    try:
        if path.read_text() == text:
            return False
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text)
    tmp.replace(path)
    return True


def load_settings():
    """settings.json + varsayılanlar; bozuk ya da aralık dışı değerler varsayılana döner."""
    data = read_json(STATE / "settings.json")
    s = dict(DEFAULTS)
    for key, default in DEFAULTS.items():
        value = data.get(key)
        if isinstance(default, bool):
            if isinstance(value, bool):
                s[key] = value
        elif isinstance(value, (int, float)) and not isinstance(value, bool):
            s[key] = type(default)(value)
    s["pointer_speed"] = round(min(1.0, max(-1.0, s["pointer_speed"])), 2)
    s["night_temp"] = min(NIGHT_MAX, max(NIGHT_MIN, s["night_temp"]))
    if s["lock_after"] not in dict(LOCK_CHOICES):
        s["lock_after"] = DEFAULTS["lock_after"]
    return s


def render_niri(s):
    # niri'de touchpad bölümü include'lar arasında birleşmez: bu blok input.kdl'dekinin
    # tamamen yerine geçer, o yüzden dwt de burada yazılı.
    lines = ["// Settings uygulamasının ürettiği dosya (Settings → Touchpad); elle düzenleme.",
             "// input.kdl'deki touchpad bloğunun yerine geçer.",
             "",
             "input {",
             "    touchpad {"]
    if s["tap"]:
        lines.append("        tap")
    lines.append("        dwt")
    if s["natural_scroll"]:
        lines.append("        natural-scroll")
    if s["pointer_speed"]:
        lines.append(f"        accel-speed {s['pointer_speed']:.2f}")
    lines += ["    }", "}", ""]
    return "\n".join(lines)


def render_env(s):
    return ("# Settings uygulamasının ürettiği dosya; elle düzenleme.\n"
            "# swayidle.service ve night-light.service okur (EnvironmentFile).\n"
            f"LOCK_AFTER={s['lock_after']}\n"
            f"SCREEN_OFF_AFTER={s['lock_after'] + SCREEN_OFF_DELAY}\n"
            f"NIGHT_TEMP={s['night_temp']}\n"
            f"NIGHT_TEMP_HIGH={s['night_temp'] + 1}\n"
            f"NIGHT_AUTO={int(s['night_auto'])}\n")


def save_settings(s):
    write_atomic(STATE / "settings.json", json.dumps(s, indent=2, sort_keys=True) + "\n")
    write_atomic(STATE / "services.env", render_env(s))
    # Touchpad'e hiç dokunulmadıysa input.kdl geçerli kalsın.
    niri = STATE / "niri.kdl"
    if niri.exists() or any(s[k] != DEFAULTS[k] for k in TOUCHPAD_KEYS):
        write_atomic(niri, render_niri(s))


ALPHA_RE = re.compile(r"^([ \t]*alpha[ \t]*=[ \t]*)([0-9.]+)[ \t]*$", re.M)


def foot_alpha(text):
    found = ALPHA_RE.findall(text)
    try:
        return min(1.0, max(0.0, float(found[-1][1]))) if found else 1.0
    except ValueError:
        return 1.0


def with_foot_alpha(text, alpha):
    """foot.ini metninde alpha değerini değiştirir (yorumlar ve geri kalan aynen kalır)."""
    value = f"{alpha:.2f}".rstrip("0").rstrip(".")
    matches = list(ALPHA_RE.finditer(text))
    if matches:
        m = matches[-1]
        return text[:m.start(2)] + value + text[m.end(2):]
    return text.rstrip("\n") + f"\n\n[colors]\nalpha={value}\n"


# ── Tema, duvar kağıtları, monitörler (yalnızca okuma) ────────────────────

def presets():
    found = []
    for path in PRESETS.glob("*.toml"):
        try:
            data = tomllib.loads(path.read_text())
        except (OSError, tomllib.TOMLDecodeError):
            continue
        found.append((path.stem, data.get("name", path.stem), data.get("ui", {})))
    return sorted(found, key=lambda p: p[1].lower())


def wallpapers():
    try:
        files = [f for f in WALLPAPERS.iterdir() if f.is_file() and not f.name.startswith(".")
                 and f.suffix.lower() in IMAGE_SUFFIXES]
    except OSError:
        return []
    return sorted(files, key=lambda f: f.name.lower())


def copy_wallpaper(src):
    """Resmi wallpapers/ klasörüne kopyalar (orada değilse); aynı adda başka resim varsa ad-2…"""
    src = Path(src).resolve()
    WALLPAPERS.mkdir(parents=True, exist_ok=True)
    if src.parent == WALLPAPERS.resolve():
        return src
    dest, n = WALLPAPERS / src.name, 2
    while dest.exists():
        if dest.read_bytes() == src.read_bytes():
            return dest.resolve()
        dest, n = WALLPAPERS / f"{src.stem}-{n}{src.suffix}", n + 1
    shutil.copy2(src, dest)
    return dest.resolve()


def parse_mimeapps(text):
    """{bölüm: {anahtar: değer}}; sıra korunur, yorumlar atılır."""
    sections, current = {}, None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            current = sections.setdefault(line[1:-1], {})
        elif current is not None and "=" in line:
            key, _, value = line.partition("=")
            current[key.strip()] = value.strip()
    return sections


def render_mimeapps(text, defaults):
    """Var olan dosyaya {MIME türü: masaüstü dosyası ya da None (kaldır)} uygular."""
    sections = parse_mimeapps(text)
    section = sections.setdefault("Default Applications", {})
    for mime, desktop in defaults.items():
        if desktop:
            section[mime] = desktop + ";"
        else:
            section.pop(mime, None)
    out = [MIMEAPPS_HEADER]
    for name, values in sections.items():
        if not values:
            continue
        out.append(f"\n[{name}]\n")
        out.extend(f"{key}={value}\n" for key, value in values.items())
    return "".join(out)


def category_defaults(app_id, types, supported):
    """Seçilen uygulamanın desteklediği türler → {tür: uygulama}. Desteklemediklerine dokunulmaz;
    ilk tür (kategoriyi temsil eden) her zaman yazılır."""
    return {mime: app_id for n, mime in enumerate(types) if n == 0 or mime in supported}


def set_default_app(app_id, types, supported, path=None):
    path = path or MIMEAPPS
    try:
        text = path.read_text()
    except OSError:
        text = ""
    write_atomic(path, render_mimeapps(text, category_defaults(app_id, types, supported)))


def load_displays():
    """`displays` komutunu modül olarak yükler: monitörü bulma kuralları tek yerde kalsın."""
    loader = importlib.machinery.SourceFileLoader("displays_cli", str(BIN / "displays"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def thumbnail(path, w, h):
    """w×h piksel, ortadan kırpılmış küçük resim; önbellekten ya da yeni. Olmazsa None."""
    try:
        st = path.stat()
    except OSError:
        return None
    key = hashlib.sha1(f"{path.resolve()}|{st.st_mtime_ns}|{st.st_size}|{w}x{h}".encode())
    cached = THUMBS / f"{key.hexdigest()}.png"
    try:
        return GdkPixbuf.Pixbuf.new_from_file(str(cached))
    except GLib.Error:
        pass
    try:
        fmt, iw, ih = GdkPixbuf.Pixbuf.get_file_info(str(path))
        if fmt is None:
            return None
        # Kısa kenar en az max(w, h) olsun: yan dönmüş (EXIF) fotoğrafta da yetsin.
        s = max(w, h) / max(1, min(iw, ih))
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), max(1, round(iw * s)),
                                                     max(1, round(ih * s)), True)
        pb = pb.apply_embedded_orientation() or pb
        pw, ph = pb.get_width(), pb.get_height()
        s = max(w / pw, h / ph)
        sw, sh = max(w, math.ceil(pw * s)), max(h, math.ceil(ph * s))
        pb = pb.scale_simple(sw, sh, GdkPixbuf.InterpType.BILINEAR)
        pb = pb.new_subpixbuf((sw - w) // 2, (sh - h) // 2, w, h).copy()
    except (GLib.Error, TypeError, ValueError):
        return None
    try:
        THUMBS.mkdir(parents=True, exist_ok=True)
        pb.savev(str(cached), "png", [], [])
    except GLib.Error:
        pass
    return pb


def thumbnails_later(jobs, scale):
    """jobs: [(karo, dosya)]. Arka planda üretir, hazır oldukça karoya verir."""
    def work():
        for tile, path in jobs:
            pb = thumbnail(path, THUMB_W * scale, THUMB_H * scale)
            if pb is not None:
                GLib.idle_add(tile.set_image, pb)
    threading.Thread(target=work, daemon=True).start()


def run(argv, done=None):
    """Komutu pencereyi dondurmadan çalıştırır; bitince done(başarılı mı, hata metni)."""
    try:
        proc = Gio.Subprocess.new([str(a) for a in argv],
                                  Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_PIPE)
    except GLib.Error as e:
        if done:
            done(False, e.message)
        return

    def finished(p, result):
        try:
            _, _, err = p.communicate_utf8_finish(result)
        except GLib.Error as e:
            err = e.message
        if done:
            lines = (err or "").strip().splitlines()
            done(p.get_successful(), lines[-1] if lines else "")
    proc.communicate_utf8_async(None, None, finished)


def night_light_on():
    try:
        out = subprocess.run([str(BIN / "night-light"), "status"], capture_output=True,
                             text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return out.strip() == "true"


# ── Çizim ─────────────────────────────────────────────────────────────────

def rgb(color):
    h = str(color).lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except ValueError:
        return (0.5, 0.5, 0.5)


def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def paint_image(cr, w, h, pb):
    cr.save()
    cr.scale(w / pb.get_width(), h / pb.get_height())
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    cr.restore()


def paint_dots(cr, x, y, colors):
    for i, color in enumerate(colors):
        cr.arc(x + i * 13, y, 4.5, 0, 2 * math.pi)
        cr.set_source_rgb(*rgb(color))
        cr.fill()


def paint_palette(cr, w, h, c):
    """Paletin minyatürü: zemin, üstünde vurgu kenarlı küçük bir pencere, renk noktaları."""
    def use(key):
        cr.set_source_rgb(*rgb(c.get(key, c.get("fg", "#808080"))))
    use("bg")
    cr.paint()
    x, y, ww, hh = 10, 9, w - 20, h - 31
    rounded(cr, x, y, ww, hh, 5)
    use("surface")
    cr.fill_preserve()
    use("accent")
    cr.set_line_width(1.5)
    cr.stroke()
    for i, (key, frac) in enumerate((("fg", 0.55), ("subtle", 0.38), ("muted", 0.46))):
        rounded(cr, x + 8, y + 8 + i * 9, (ww - 16) * frac, 4, 2)
        use(key)
        cr.fill()
    paint_dots(cr, x + 5, h - 11, [c.get(k, "#808080") for k in ("accent", "accent2", "ok", "warn", "urgent")])


# ── Küçük parçalar ────────────────────────────────────────────────────────

def label(text, cls=None, **kw):
    kw.setdefault("xalign", 0)
    widget = Gtk.Label(label=text, **kw)
    if cls:
        widget.get_style_context().add_class(cls)
    return widget


def note(text):
    return label(text, "note", wrap=True, max_width_chars=64)


def row(title, widget, hint=None, below=False):
    """Başlık (ve açıklama) solda, denetim sağda; below=True: denetim altta."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL if below else Gtk.Orientation.HORIZONTAL,
                  spacing=10 if below else 24)
    box.get_style_context().add_class("row")
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    text.add(label(title))
    if hint:
        text.add(note(hint))
    if below:
        box.add(text)
        widget.set_halign(Gtk.Align.START)
        box.add(widget)
    else:
        box.pack_start(text, True, True, 0)
        widget.set_valign(Gtk.Align.CENTER)
        box.pack_end(widget, False, False, 0)
    return box


class Later:
    """fn'yi son çağrıdan ms sonra bir kez çalıştırır: sürgü sürüklenirken her adımda dosya
    yazılmasın, servis yeniden başlamasın. flush(): bekleyen varsa hemen çalıştır."""

    def __init__(self, ms, fn):
        self.ms, self.fn, self.source, self.args = ms, fn, 0, ()

    def __call__(self, *args):
        self.args = args
        if self.source:
            GLib.source_remove(self.source)
        self.source = GLib.timeout_add(self.ms, self.fire)

    def fire(self):
        self.source = 0
        self.fn(*self.args)
        return False

    def flush(self):
        if self.source:
            GLib.source_remove(self.source)
            self.fire()


class Choice(Gtk.Box):
    """Yan yana düğmeler, biri seçili. on_pick(değer) yalnızca tıklanınca çağrılır."""

    def __init__(self, options, on_pick):
        super().__init__()
        self.get_style_context().add_class("choice")
        self.buttons = {}
        for value, text in options:
            button = Gtk.Button(label=text)
            button.connect("clicked", lambda _b, v=value: on_pick(v))
            self.buttons[value] = button
            self.add(button)

    def set(self, value):
        for v, button in self.buttons.items():
            ctx = button.get_style_context()
            (ctx.add_class if v == value else ctx.remove_class)("selected")


ICON_PX = 24                    # bazı simge temaları 24 px'lik boy vermiyor; hepsi aynı boyda olsun


def app_icon(app):
    return app.get_icon() or Gio.ThemedIcon.new("application-x-executable")


class AppButton(Gtk.MenuButton):
    """Seçili uygulamanın simgesi ve adı; tıklayınca o türü açabilen uygulamaların listesi."""

    def __init__(self, on_pick):
        super().__init__()
        self.on_pick = on_pick
        self.get_style_context().add_class("app-button")
        box = Gtk.Box(spacing=8)
        self.icon = Gtk.Image(pixel_size=ICON_PX)
        self.name = label("", ellipsize=Pango.EllipsizeMode.END, max_width_chars=22)
        box.add(self.icon)
        box.add(self.name)
        box.pack_end(Gtk.Image.new_from_icon_name("pan-down-symbolic", Gtk.IconSize.MENU), False, False, 0)
        self.add(box)
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list.connect("row-activated", self.picked)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      propagate_natural_height=True, max_content_height=360)
        scroller.add(self.list)
        scroller.show_all()
        self.popover = Gtk.Popover()
        self.popover.get_style_context().add_class("apps")
        self.popover.add(scroller)
        self.set_popover(self.popover)

    def load(self, mime):
        current = Gio.AppInfo.get_default_for_type(mime, False)
        self.show_app(current)
        apps, seen = [], set()
        for app in ([current] if current else []) + list(Gio.AppInfo.get_all_for_type(mime)):
            if app.get_id() in seen or not (app.should_show() or app is current):
                continue
            seen.add(app.get_id())
            apps.append(app)
        for child in self.list.get_children():
            child.destroy()
        for app in sorted(apps, key=lambda a: a.get_display_name().lower()):
            item = Gtk.ListBoxRow()
            item.app = app
            box = Gtk.Box(spacing=10)
            box.add(Gtk.Image(gicon=app_icon(app), pixel_size=ICON_PX))
            box.add(label(app.get_display_name()))
            if current and app.get_id() == current.get_id():
                item.get_style_context().add_class("current")
            item.add(box)
            item.show_all()
            self.list.add(item)
        self.set_sensitive(bool(apps))

    def show_app(self, app):
        if app is None:
            self.icon.clear()
            self.name.set_text("None")
            return
        self.icon.set_from_gicon(app_icon(app), Gtk.IconSize.LARGE_TOOLBAR)
        self.name.set_text(app.get_display_name())

    def picked(self, _list, item):
        self.popover.popdown()
        self.show_app(item.app)
        for child in self.list.get_children():
            ctx = child.get_style_context()
            (ctx.add_class if child is item else ctx.remove_class)("current")
        self.on_pick(item.app)


class Switch(Gtk.Switch):
    def __init__(self, on_toggle):
        super().__init__()
        self.handler = self.connect("notify::active", lambda s, _p: on_toggle(s.get_active()))

    def set(self, value):
        with self.handler_block(self.handler):
            self.set_active(value)


class Slider(Gtk.Box):
    def __init__(self, lo, hi, step, fmt, on_change, inverted=False):
        super().__init__(spacing=10)
        self.step, self.fmt, self.on_change = step, fmt, on_change
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        self.scale.set_draw_value(False)
        self.scale.set_inverted(inverted)
        self.scale.set_size_request(200, -1)
        # Tekerlek sayfayı kaydırsın, sürgüyü değil (yanlışlıkla değer değişmesin).
        self.scale.connect("scroll-event", self.pass_scroll)
        self.value_label = label("", "value", width_chars=7, xalign=1)
        self.add(self.scale)
        self.add(self.value_label)
        self.handler = self.scale.connect("value-changed", self.changed)

    @staticmethod
    def pass_scroll(scale, _event):
        scale.stop_emission_by_name("scroll-event")
        return False

    def value(self):
        return round(round(self.scale.get_value() / self.step) * self.step, 2)

    def changed(self, _scale):
        self.value_label.set_text(self.fmt(self.value()))
        self.on_change(self.value())

    def set(self, value):
        with self.scale.handler_block(self.handler):
            self.scale.set_value(value)
        self.value_label.set_text(self.fmt(self.value()))


class Tile(Gtk.FlowBoxChild):
    """Resimli seçenek (duvar kağıdı ya da renk paleti). paint(karo, cr, w, h) resmi çizer."""

    def __init__(self, key, title, paint):
        super().__init__()
        self.key, self.paint, self.image = key, paint, None
        self.area = Gtk.DrawingArea()
        self.area.set_size_request(THUMB_W, THUMB_H)
        self.area.connect("draw", self.on_draw)
        frame = Gtk.Box(halign=Gtk.Align.CENTER)
        frame.get_style_context().add_class("frame")
        frame.add(self.area)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.add(frame)
        box.add(Gtk.Label(label=title, ellipsize=Pango.EllipsizeMode.END, max_width_chars=16))
        self.add(box)

    def set_image(self, pixbuf):
        self.image = pixbuf
        self.area.queue_draw()
        return False

    def on_draw(self, area, cr):
        w, h = area.get_allocated_width(), area.get_allocated_height()
        rounded(cr, 0, 0, w, h, 7)
        cr.clip()
        self.paint(self, cr, w, h)


def flowbox(on_activate):
    box = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, homogeneous=True,
                      column_spacing=8, row_spacing=10, max_children_per_line=8,
                      valign=Gtk.Align.START)
    box.set_activate_on_single_click(True)
    box.connect("child-activated", on_activate)
    return box


def select(box, key):
    tile = next((t for t in box.get_children() if t.key == key), None)
    if tile is None:
        box.unselect_all()
    else:
        box.select_child(tile)


