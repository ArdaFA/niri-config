gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GLib  # noqa: E402

APP_ID = "dotfiles.settings"
# GTK3 Wayland'de pencere kimliği (app_id) program adıdır; niri'nin yüzen pencere kuralı
# bununla eşleşir. Gtk yüklenmeden önce ayarlanmalı, yoksa "settings" olur.
GLib.set_prgname(APP_ID)
from gi.repository import Gdk, GdkPixbuf, Gio, Gtk, Pango  # noqa: E402

HOME = Path.home()
BIN = Path(__file__).resolve().parent                 # theme, displays, night-light burada
REPO = Path(__file__).resolve().parents[3]            # ~/dotfiles
PRESETS = REPO / "themes" / "presets"
WALLPAPERS = REPO / "wallpapers"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
STATE = STATE_HOME / "settings"
THEME_STATE = STATE_HOME / "theme"
FOOT_INI = CONFIG_HOME / "foot" / "foot.ini"
THUMBS = CACHE_HOME / "settings" / "thumbnails"

PAGES = (("appearance", "Appearance"), ("displays", "Displays"),
         ("touchpad", "Touchpad"), ("lock", "Screen lock"), ("apps", "Default apps"))
DEFAULTS = {"tap": True, "natural_scroll": False, "pointer_speed": 0.0,
            "lock_after": 300, "night_temp": 4000, "night_auto": False}
TOUCHPAD_KEYS = ("tap", "natural_scroll", "pointer_speed")
LOCK_CHOICES = ((60, "1 min"), (120, "2 min"), (300, "5 min"), (600, "10 min"),
                (900, "15 min"), (1800, "30 min"), (3600, "1 hour"))
SCREEN_OFF_DELAY = 30           # kilitten bu kadar saniye sonra ekran kapanır
NIGHT_MIN, NIGHT_MAX = 2500, 5500
NIGHT_FROM, NIGHT_UNTIL = "19:00", "07:00"      # otomatik gece ışığı (night-light-auto.timer)
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png"}
THUMB_W, THUMB_H = 124, 70      # mantıksal piksel (16:9)

# Varsayılan uygulamalar: (anahtar, başlık, açıklama, MIME türleri). İlk tür, şu anki seçimi
# göstermek ve adayları bulmak için kullanılır; seçilen uygulama listedeki türlerden
# desteklediği her birinin varsayılanı olur.
MIMEAPPS = CONFIG_HOME / "niri-mimeapps.list"
APP_CATEGORIES = (
    ("browser", "Web browser", "Links and web pages",
     ("x-scheme-handler/https", "x-scheme-handler/http", "text/html", "application/xhtml+xml",
      "x-scheme-handler/about", "x-scheme-handler/unknown")),
    ("files", "Files", "Folders", ("inode/directory",)),
    ("text", "Text editor", "Plain text, Markdown, code",
     ("text/plain", "text/markdown", "application/json", "application/x-shellscript",
      "text/x-python", "application/toml", "application/x-yaml", "text/x-log")),
    ("images", "Images", None,
     ("image/png", "image/jpeg", "image/gif", "image/webp", "image/avif", "image/heif",
      "image/bmp", "image/tiff", "image/svg+xml", "image/jxl")),
    ("pdf", "PDF documents", None, ("application/pdf",)),
    ("video", "Videos", None,
     ("video/mp4", "video/webm", "video/x-matroska", "video/quicktime", "video/mpeg",
      "video/x-msvideo", "video/ogg", "video/3gpp")),
    ("music", "Music", None,
     ("audio/mpeg", "audio/flac", "audio/x-flac", "audio/ogg", "audio/x-vorbis+ogg",
      "audio/opus", "audio/wav", "audio/x-wav", "audio/mp4", "audio/aac")),
    ("archives", "Archives", "zip, tar, 7z…",
     ("application/zip", "application/x-tar", "application/x-compressed-tar",
