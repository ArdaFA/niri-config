def theme_css():
    try:
        colors = (THEME_STATE / "panel.css").read_bytes()
    except OSError:
        colors = FALLBACK_COLORS
    if b"panel_subtle" not in colors:             # eski panel.css: theme apply çalışmadan önce
        colors += b"@define-color panel_subtle @panel_muted;\n"
    return colors + CSS


# ── Pencere ───────────────────────────────────────────────────────────────

class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.app = app
        self.set_default_size(960, 660)
        self.set_icon_name("preferences-system")
        self.get_style_context().add_class("settings")
        self.settings = load_settings()
        self.theme = {}
        self.palette = {}
        self.theme_busy, self.theme_next = False, None
        self.status_timer = 0
        self.scale = max([1] + [Gdk.Display.get_default().get_monitor(i).get_scale_factor()
                                for i in range(Gdk.Display.get_default().get_n_monitors())])
        self.pending = []                          # Later nesneleri: kapanırken boşaltılır

        self.stack = Gtk.Stack()
        self.refreshers = {}
        for name, title in PAGES:
            page, refresh = getattr(self, f"page_{name}")(title)
            scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            scroller.add(page)
            self.stack.add_named(scroller, name)
            self.refreshers[name] = refresh

        self.nav = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        for name, title in PAGES:
            item = Gtk.ListBoxRow()
            item.name = name
            item.add(label(title))
            self.nav.add(item)
        self.nav.connect("row-selected", self.on_nav)
        self.status_label = label("", "status", wrap=True, max_width_chars=18, valign=Gtk.Align.END)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sidebar.get_style_context().add_class("sidebar")
        sidebar.set_size_request(170, -1)
        sidebar.add(label("Settings", "app-title"))
        sidebar.add(self.nav)
        sidebar.pack_end(self.status_label, True, True, 0)
        body = Gtk.Box()
        body.add(sidebar)
        body.pack_start(self.stack, True, True, 0)
        self.add(body)

        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", self.on_close)
        self.connect("focus-in-event", self.on_focus)

    # Sayfalar arası

    def show_page(self, name):
        item = next((r for r in self.nav.get_children() if r.name == name), None)
        if item is not None:
            if self.nav.get_selected_row() is item:
                self.refreshers[name]()
            self.nav.select_row(item)

    def on_nav(self, _nav, item):
        if item is not None:
            self.stack.set_visible_child_name(item.name)
            self.refreshers[item.name]()

    def on_focus(self, *_):
        # Başka yerden yapılan değişiklikler (Super+Shift+T, monitör takıldı…) görünsün.
        self.app.reload_css()
        item = self.nav.get_selected_row()
        if item is not None:
            self.refreshers[item.name]()
        return False

    def on_key(self, _w, event):
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        if event.keyval == Gdk.KEY_Escape or (ctrl and event.keyval in (Gdk.KEY_w, Gdk.KEY_q)):
            self.close()
            return True
        return False

    def on_close(self, *_):
        for later in self.pending:
            later.flush()
        return False

    def later(self, ms, fn):
        later = Later(ms, fn)
        self.pending.append(later)
        return later

    def status(self, text, error=False):
        self.status_label.set_text(text)
        ctx = self.status_label.get_style_context()
        (ctx.add_class if error else ctx.remove_class)("error")
        if self.status_timer:
            GLib.source_remove(self.status_timer)
            self.status_timer = 0
        if text and not self.theme_busy:
            self.status_timer = GLib.timeout_add_seconds(6 if error else 3, self.clear_status)

    def clear_status(self):
        self.status_timer = 0
        self.status_label.set_text("")
        return False

    def failed(self, what):
        def done(ok, err):
            if not ok:
                self.status(f"{what} failed" + (f": {err}" if err else ""), error=True)
        return done

    def save(self, key, value):
        self.settings[key] = value
        try:
            save_settings(self.settings)
        except OSError as e:
            self.status(f"Could not save: {e.strerror}", error=True)
            return False
        return True

    def page(self, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=22,
                      margin_bottom=28, margin_start=28, margin_end=28)
        box.add(label(title, "page-title"))
        return box

    # ── Appearance ──

    def page_appearance(self, title):
        page = self.page(title)
        page.add(label("Wallpaper", "heading"))
        self.walls = flowbox(self.on_wallpaper)
        page.add(self.walls)
        page.add(label("Colors", "heading"))
        self.colors = flowbox(self.on_colors)
        page.add(self.colors)
        self.variant = Choice((("light", "Light"), ("dark", "Dark"), ("auto", "Auto")), self.on_variant)
        self.variant_row = row("Wallpaper colors", self.variant,
                               "Light or dark colors, taken from the wallpaper. "
                               "Auto: light from 07:00, dark from 19:00")
        page.add(self.variant_row)
        page.add(label("Terminal", "heading"))
        self.opacity = Slider(50, 100, 5, lambda v: f"{v:.0f} %",
                              self.later(300, self.set_opacity))
        page.add(row("Opacity", self.opacity,
                     "For new terminal windows. The wallpaper shows through, blurred."))

        self.fill_wallpapers()
        self.from_wallpaper = Tile("wallpaper", "From wallpaper", self.paint_from_wallpaper)
        self.from_wallpaper.path = None
        self.colors.add(self.from_wallpaper)
        for key, name, ui in presets():
            self.colors.add(Tile(key, name, lambda _t, cr, w, h, ui=ui: paint_palette(cr, w, h, ui)))
        return page, self.refresh_appearance

    def fill_wallpapers(self):
        for tile in self.walls.get_children():
            tile.destroy()
        jobs = []
        for path in wallpapers():
            tile = Tile(str(path.resolve()), path.stem, self.paint_wallpaper)
            self.walls.add(tile)
            jobs.append((tile, path))
        self.walls.add(Tile("none", "None", self.paint_none))
        self.walls.add(Tile("add", "Add…", self.paint_add))
        self.walls.show_all()
        thumbnails_later(jobs, self.scale)

    def color(self, key):
        return rgb(self.palette.get(key, "#808080"))

    def paint_wallpaper(self, tile, cr, w, h):
        if tile.image is not None:
            paint_image(cr, w, h, tile.image)
        else:
            cr.set_source_rgb(*self.color("surface"))
            cr.paint()

    def paint_none(self, _tile, cr, w, h):
        cr.set_source_rgb(*self.color("bg"))
        cr.paint()
        cr.set_source_rgb(*self.color("overlay"))
        rounded(cr, 1, 1, w - 2, h - 2, 6)
        cr.set_line_width(2)
        cr.stroke()
        cr.move_to(w * 0.38, h * 0.72)
        cr.line_to(w * 0.62, h * 0.28)
        cr.stroke()

    def paint_add(self, _tile, cr, w, h):
        cr.set_source_rgb(*self.color("surface"))
        cr.paint()
        cr.set_source_rgb(*self.color("subtle"))
        cr.set_line_width(2)
        for dx, dy in ((9, 0), (0, 9)):
            cr.move_to(w / 2 - dx, h / 2 - dy)
            cr.line_to(w / 2 + dx, h / 2 + dy)
        cr.stroke()

    def paint_from_wallpaper(self, tile, cr, w, h):
        self.paint_wallpaper(tile, cr, w, h)
        if self.theme.get("source") == "wallpaper":
            # Duvar kağıdından üretilmiş geçerli renkler: altta küçük bir şeritte.
            rounded(cr, 6, h - 21, 72, 15, 7)
            cr.set_source_rgb(*self.color("bg"))
            cr.fill()
            paint_dots(cr, 14, h - 13.5, [self.palette.get(k, "#808080")
                                          for k in ("accent", "accent2", "ok", "warn", "urgent")])

    def refresh_appearance(self):
        if self.theme_busy:
            return                                 # sonuç gelince zaten yenilenecek
        self.theme = read_json(THEME_STATE / "state.json")
        self.palette = read_json(THEME_STATE / "palette.json")
        wallpaper = self.theme.get("wallpaper")
        from_wallpaper = self.theme.get("source") == "wallpaper"
        select(self.walls, str(Path(wallpaper).resolve()) if wallpaper else "none")
        select(self.colors, "wallpaper" if from_wallpaper else self.theme.get("preset", "sakura"))
        self.from_wallpaper.set_sensitive(bool(wallpaper))
        if wallpaper != self.from_wallpaper.path:
            self.from_wallpaper.path, self.from_wallpaper.image = wallpaper, None
            if wallpaper:
                thumbnails_later([(self.from_wallpaper, Path(wallpaper))], self.scale)
        self.variant.set("auto" if self.theme.get("auto") else self.theme.get("variant", "dark"))
        self.variant_row.set_visible(from_wallpaper and bool(wallpaper))
        for box in (self.walls, self.colors):
            for tile in box.get_children():
                tile.area.queue_draw()
        try:
            self.opacity.set(round(foot_alpha(FOOT_INI.read_text()) * 100))
        except OSError:
            self.opacity.set(100)

    def run_theme(self, args):
        if self.theme_busy:                        # sırada en fazla bir istek: en sonuncusu
            self.theme_next = args
            return
        self.theme_busy = True
        self.status("Applying…")
        run([BIN / "theme", *args], self.theme_done)

    def theme_done(self, ok, err):
        self.theme_busy = False
        if self.theme_next:
            args, self.theme_next = self.theme_next, None
            self.run_theme(args)
            return
        self.app.reload_css()
        self.refresh_appearance()
        if ok:
            self.status("")
        else:
            self.status(f"Theme failed: {err}" if err else "Theme failed", error=True)

    def on_wallpaper(self, _box, tile):
        if tile.key == "add":
            self.add_wallpaper()
            return
        current = self.theme.get("wallpaper")
        if tile.key == "none":
            if current:
                self.run_theme(["wallpaper", "none"])
            return
        if current and str(Path(current).resolve()) == tile.key:
            return
        self.choose_wallpaper(tile.key)

    def choose_wallpaper(self, path):
        # Renkler duvar kağıdından geliyorsa yeni resimden yeniden üretilir; preset seçiliyse kalır.
        if self.theme.get("source") == "wallpaper":
            self.run_theme(["wallpaper", path])
        else:
            self.run_theme(["wallpaper", path, "--keep-colors"])

    def add_wallpaper(self):
        dialog = Gtk.FileChooserNative.new("Add wallpaper", self, Gtk.FileChooserAction.OPEN,
                                           "Add", "Cancel")
        images = Gtk.FileFilter()
        images.set_name("Images (JPEG, PNG)")
        for suffix in IMAGE_SUFFIXES:
            images.add_pattern(f"*{suffix}")
            images.add_pattern(f"*{suffix.upper()}")
        dialog.add_filter(images)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures:
            dialog.set_current_folder(pictures)
        chosen = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        dialog.destroy()
        if not chosen:
            self.refresh_appearance()              # "Add…" seçili kalmasın
            return
        try:
            path = copy_wallpaper(chosen)
        except OSError as e:
            self.status(f"Could not add the image: {e.strerror}", error=True)
            self.refresh_appearance()
            return
        self.fill_wallpapers()
        select(self.walls, str(path))
        self.choose_wallpaper(str(path))

    def on_colors(self, _box, tile):
        wallpaper = self.theme.get("wallpaper")
        if tile.key == "wallpaper":
            if wallpaper and self.theme.get("source") != "wallpaper":
                self.run_theme(["wallpaper", wallpaper])
        elif self.theme.get("source") == "wallpaper" or self.theme.get("preset") != tile.key:
            self.run_theme(["preset", tile.key])

    def on_variant(self, variant):
        wallpaper = self.theme.get("wallpaper")
        current = "auto" if self.theme.get("auto") else self.theme.get("variant")
        if not wallpaper or variant == current:
            return
        self.variant.set(variant)
        if variant == "auto":
            self.run_theme(["auto", "on"])
        else:                                       # elle seçmek otomatiği kapatır
            self.run_theme(["wallpaper", wallpaper, f"--{variant}"])

    def set_opacity(self, percent):
        path = FOOT_INI.resolve()                  # symlink'in hedefi (repo); bağlantı bozulmasın
        try:
            write_atomic(path, with_foot_alpha(path.read_text(), percent / 100))
        except OSError as e:
            self.status(f"Could not change foot.ini: {e.strerror}", error=True)

    # ── Displays ──

    def page_displays(self, title):
        page = self.page(title)
        page.add(label("External monitor", "heading"))
        self.monitor = label("")
        self.monitor_missing = note("")
        self.place = {}
        grid = Gtk.Grid(column_spacing=6, row_spacing=6, margin_top=8, margin_bottom=6)
        grid.get_style_context().add_class("place")
        for place, text, col, line in (("above", "Above", 1, 0), ("left", "Left", 0, 1),
                                       ("right", "Right", 2, 1), ("below", "Below", 1, 2)):
            button = Gtk.Button(label=text)
            button.connect("clicked", lambda _b, p=place: self.on_place(p))
            grid.attach(button, col, line, 1, 1)
            self.place[place] = button
        grid.attach(label("Laptop", "laptop", xalign=0.5), 1, 1, 1, 1)
        auto = Gtk.Button(label="Automatic (right)")
        auto.connect("clicked", lambda _b: self.on_place("auto"))
        grid.attach(auto, 0, 3, 3, 1)
        self.place["auto"] = auto
        self.monitor_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.monitor_box.add(self.monitor)
        self.monitor_box.add(grid)
        self.monitor_box.add(note("Each monitor remembers its place and goes back to it whenever "
                                  "it is plugged in. Shortcut: Super+P."))
        page.add(self.monitor_box)
        page.add(self.monitor_missing)

        page.add(label("Night light", "heading"))
        self.night = Switch(self.on_night)
        page.add(row("Night light", self.night, "Warm screen colors for the evening"))
        self.night_auto = Switch(self.on_night_auto)
        page.add(row("Turn on automatically", self.night_auto,
                     f"On at {NIGHT_FROM}, off at {NIGHT_UNTIL}. You can still switch it in between"))
        self.warmth = Slider(NIGHT_MIN, NIGHT_MAX, 100, lambda v: f"{v:.0f} K",
                             self.later(400, self.set_warmth), inverted=True)
        self.warmth.set(self.settings["night_temp"])
        page.add(row("Warmth", self.warmth, "Further right is warmer"))
        return page, self.refresh_displays

    def refresh_displays(self):
        try:
            displays = load_displays()
        except (OSError, SyntaxError, ImportError) as e:
            self.show_monitor(None, f"The displays command is missing ({e}).")
        else:
            try:
                _laptop, target = displays.current_screens()
            except displays.Error as e:
                text = str(e)
                self.show_monitor(None, text[:1].upper() + text[1:] + ".")
            else:
                name = " ".join(x for x in (target.get("make"), target.get("model")) if x)
                place = displays.load_state().get(displays.monitor_id(target), {}).get("place", "auto")
                self.show_monitor(f"{name or target['name']}  ·  {target['name']}", None, place)
        self.night.set(night_light_on())
        self.night_auto.set(self.settings["night_auto"])

    def show_monitor(self, name, missing, place=None):
        self.monitor_box.set_visible(name is not None)
        self.monitor_missing.set_visible(missing is not None)
        if name is not None:
            self.monitor.set_text(name)
            for p, button in self.place.items():
                ctx = button.get_style_context()
                (ctx.add_class if p == place else ctx.remove_class)("selected")
        if missing is not None:
            self.monitor_missing.set_text(missing)

    def on_place(self, place):
        def done(ok, err):
            self.refresh_displays()
            if not ok:
                self.status(f"Moving the monitor failed: {err}", error=True)
        run([BIN / "displays", place], done)

    def on_night(self, on):
        def done(ok, err):
            self.night.set(night_light_on())
            if not ok:
                self.status(f"Night light failed: {err}" if err else "Night light failed", error=True)
        run([BIN / "night-light", "on" if on else "off"], done)

    def on_night_auto(self, on):
        if not self.save("night_auto", on) or not on:
            return              # kapatınca gece ışığı olduğu gibi kalır

        def done(ok, err):
            self.night.set(night_light_on())
            if not ok:
                self.status(f"Night light failed: {err}" if err else "Night light failed", error=True)
        run([BIN / "night-light", "auto"], done)     # şimdi saate göre: akşamsa açılır

    def set_warmth(self, kelvin):
        if self.save("night_temp", int(kelvin)):
            # Açıksa yeni sıcaklıkla yeniden başlat; kapalıysa bir dahaki açılışta geçerli.
            run(["systemctl", "--user", "try-restart", "night-light.service"],
                self.failed("Night light"))

    # ── Touchpad ──

    def page_touchpad(self, title):
        page = self.page(title)
        self.tap = Switch(lambda on: self.save("tap", on))
        self.natural = Switch(lambda on: self.save("natural_scroll", on))
        self.speed = Slider(-1, 1, 0.1, lambda v: "default" if v == 0 else f"{v:+.1f}",
                            self.later(300, lambda v: self.save("pointer_speed", v)))
        page.add(row("Tap to click", self.tap, "A light tap counts as a click"))
        page.add(row("Natural scrolling", self.natural, "Content moves with your fingers, like on a phone"))
        page.add(row("Pointer speed", self.speed))
        return page, self.refresh_touchpad

    def refresh_touchpad(self):
        self.tap.set(self.settings["tap"])
        self.natural.set(self.settings["natural_scroll"])
        self.speed.set(self.settings["pointer_speed"])

    # ── Screen lock ──

    def page_lock(self, title):
        page = self.page(title)
        self.lock = Choice(LOCK_CHOICES, self.set_lock)
        page.add(row("Lock the screen after", self.lock,
                     f"of inactivity. The screen turns off {SCREEN_OFF_DELAY} seconds later.",
                     below=True))
        page.add(note("To keep the screen on for a while (a film, a talk), turn on "
                      "Stay awake in quick settings."))
        return page, lambda: self.lock.set(self.settings["lock_after"])

    def set_lock(self, seconds):
        self.lock.set(seconds)
        if self.save("lock_after", seconds):
            run(["systemctl", "--user", "try-restart", "swayidle.service"], self.failed("Screen lock"))

    # ── Default apps ──

    def page_apps(self, title):
        page = self.page(title)
        page.add(note("Used only in this niri session; KDE keeps its own choices."))
        self.app_buttons = {}
        for key, name, hint, types in APP_CATEGORIES:
            button = AppButton(lambda app, types=types, name=name: self.set_app(name, types, app))
            self.app_buttons[key] = (button, types)
            page.add(row(name, button, hint))
        return page, self.refresh_apps

    def refresh_apps(self):
        for button, types in self.app_buttons.values():
            button.load(types[0])

    def set_app(self, name, types, app):
        try:
            set_default_app(app.get_id(), types, set(app.get_supported_types() or ()))
        except OSError as e:
            self.status(f"Could not save: {e.strerror}", error=True)
            return
        self.status(f"{name}: {app.get_display_name()}")

    def raise_to_front(self):
        """Pencere zaten açıkken yeniden çağrılınca: niri'den bu pencereye odaklanmasını iste."""
        try:
            out = subprocess.run(["niri", "msg", "--json", "windows"], capture_output=True,
                                 text=True, timeout=2).stdout
            wid = next(w["id"] for w in json.loads(out) if w.get("pid") == os.getpid())
            subprocess.run(["niri", "msg", "action", "focus-window", "--id", str(wid)],
                           capture_output=True, timeout=2)
        except (OSError, ValueError, StopIteration, subprocess.TimeoutExpired):
            self.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.window, self.css, self.css_text = None, None, None

    def reload_css(self):
        if self.css is None:
            self.css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css,
                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        text = theme_css()
        if text != self.css_text:
            self.css_text = text
            try:
                self.css.load_from_data(text)
            except GLib.Error:
                self.css.load_from_data(FALLBACK_COLORS + CSS)

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        page = args[0] if args else None
        if self.window is None:
            self.reload_css()
            self.window = Window(self)
            self.window.show_all()
            self.window.show_page(page or PAGES[0][0])
        else:
            if page:
                self.window.show_page(page)
            self.window.raise_to_front()
        return 0


# ── Selftest (check.sh) ───────────────────────────────────────────────────

def selftest():
    import tempfile
    global STATE
    original = STATE
    with tempfile.TemporaryDirectory() as tmp:
        STATE = Path(tmp)
        try:
            assert load_settings() == DEFAULTS
            (STATE / "settings.json").write_text(json.dumps(
                {"tap": "yes", "pointer_speed": 7, "lock_after": 61, "night_temp": 100,
                 "natural_scroll": True}))
            s = load_settings()
            assert s == dict(DEFAULTS, pointer_speed=1.0, night_temp=NIGHT_MIN, natural_scroll=True), s
            (STATE / "settings.json").unlink()

            # Touchpad'e dokunulmadıkça niri.kdl yazılmaz; dokunulunca hep yazılır.
            s = dict(DEFAULTS, lock_after=600)
            save_settings(s)
            assert not (STATE / "niri.kdl").exists()
            env = (STATE / "services.env").read_text()
            assert "LOCK_AFTER=600\n" in env and "SCREEN_OFF_AFTER=630\n" in env, env
            assert "NIGHT_TEMP=4000\n" in env and "NIGHT_TEMP_HIGH=4001\n" in env, env
            assert "NIGHT_AUTO=0\n" in env, env
            save_settings(dict(s, night_auto=True))
            assert "NIGHT_AUTO=1\n" in (STATE / "services.env").read_text()
            s.update(tap=False, natural_scroll=True, pointer_speed=-0.3)
            save_settings(s)
            kdl = (STATE / "niri.kdl").read_text()
            assert "tap\n" not in kdl and "dwt" in kdl and "natural-scroll" in kdl, kdl
            assert "accel-speed -0.30" in kdl, kdl
            s.update(tap=True, natural_scroll=False, pointer_speed=0.0)
            save_settings(s)
            kdl = (STATE / "niri.kdl").read_text()
            assert "        tap\n" in kdl and "natural" not in kdl and "accel" not in kdl, kdl
            assert load_settings() == s
            if shutil.which("niri"):
                out = subprocess.run(["niri", "validate", "-c", str(STATE / "niri.kdl")],
                                     capture_output=True, text=True)
                assert out.returncode == 0, out.stderr[-500:]
        finally:
            STATE = original

    foot = "[main]\ninclude=x\n# alpha=0.2 (yorum)\n[colors]\nalpha=0.8\n"
    assert foot_alpha(foot) == 0.8 and foot_alpha("[main]\n") == 1.0
    assert with_foot_alpha(foot, 0.85) == foot.replace("alpha=0.8", "alpha=0.85")
    assert with_foot_alpha(foot, 1.0).endswith("alpha=1\n")
    assert with_foot_alpha("[main]\nfont=x\n", 0.5) == "[main]\nfont=x\n\n[colors]\nalpha=0.5\n"
    assert "alpha = 0.6  " in with_foot_alpha("alpha = 0.9  \n", 0.6)
    assert presets() and all(len(p) == 3 for p in presets())

    # Varsayılan uygulamalar: yalnızca desteklenen türler; başka bölümler ve anahtarlar korunur.
    types = ("image/png", "image/jpeg", "image/jxl")
    assert category_defaults("v.desktop", types, {"image/jpeg"}) == \
        {"image/png": "v.desktop", "image/jpeg": "v.desktop"}
    old = "# yorum\n[Added Associations]\ntext/x-c=a.desktop;\n\n[Default Applications]\nimage/png=x.desktop;\nimage/jxl=z.desktop;\n"
    new = render_mimeapps(old, {"image/png": "v.desktop", "image/jpeg": "v.desktop"})
    parsed = parse_mimeapps(new)
    assert parsed == {"Added Associations": {"text/x-c": "a.desktop;"},
                      "Default Applications": {"image/png": "v.desktop;", "image/jxl": "z.desktop;",
                                               "image/jpeg": "v.desktop;"}}, parsed
    assert new.startswith("# niri") and "# yorum" not in new
    assert "image/png" not in parse_mimeapps(render_mimeapps(new, {"image/png": None}))["Default Applications"]
    with tempfile.TemporaryDirectory() as tmp:
        path = Path(tmp) / "niri-mimeapps.list"
        set_default_app("b.desktop", APP_CATEGORIES[0][3], {"x-scheme-handler/http", "text/html"}, path)
        got = parse_mimeapps(path.read_text())["Default Applications"]
        assert got == {"x-scheme-handler/https": "b.desktop;", "x-scheme-handler/http": "b.desktop;",
                       "text/html": "b.desktop;"}, got
        apps = Path(tmp) / "applications"            # GLib var olmayan uygulamayı yok sayar
        apps.mkdir()
        (apps / "b.desktop").write_text("[Desktop Entry]\nType=Application\nName=B\nExec=true %u\n"
                                        "MimeType=text/html;\n")
        env = dict(os.environ, XDG_CONFIG_HOME=tmp, XDG_DATA_HOME=tmp, XDG_CURRENT_DESKTOP="niri")
        if shutil.which("gio"):
            out = subprocess.run(["gio", "mime", "text/html"], env=env, capture_output=True, text=True)
            assert "b.desktop" in out.stdout.splitlines()[0], out.stdout
    print("ok")


def main():
    args = sys.argv[1:]
    if args[:1] == ["selftest"]:
        selftest()
        return
    if args[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return
    if len(args) > 1 or (args and args[0] not in dict(PAGES)):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    sys.exit(App().run(sys.argv))


if __name__ == "__main__":
    main()
