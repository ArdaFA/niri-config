#!/usr/bin/env python3
"""bar-status — status modules for Waybar. Each one prints a JSON line whenever its
state changes; an empty text hides the module.

  bar-status privacy        MIC / CAM / SCR while the microphone, camera or screen sharing is in use;
                            notification popups are held back while the screen is shared
  bar-status mic            MIC off while the microphone is muted
  bar-status failed         FAIL n while a systemd service (user or system) has failed
  bar-status system         CPU / MEM / TEMP while load, memory use or temperature stays high
  bar-status vpn            VPN while traffic goes through a VPN
  bar-status power          ECO / PERF while the power profile is not "balanced"
  bar-status power reset    switch the power profile back to "balanced"
  bar-status volume         VOL n% (FreeBSD: Waybar's wireplumber module needs PipeWire)
  bar-status backlight      LCD n% (FreeBSD: Waybar's backlight module is Linux-only)
  bar-status network        NET name (FreeBSD: Waybar's network module is Linux-only)
  bar-status selftest       check the detection rules against sample data
"""
# Not: Ekranda görünen metinler İngilizce; yorumlar Türkçe.
#
# Neden Waybar'ın kendi "privacy" modülü değil: o modül metin değil simge gösteriyor (bar baştan
# sona retro metin) ve kamerayı yalnızca PipeWire üzerinden görüyor; tarayıcılar kamerayı
# çoğunlukla doğrudan /dev/video* ile açar.

import json
import os
import re
import socket
import subprocess
import sys
import time

FREEBSD = sys.platform.startswith("freebsd")

PRIVACY_INTERVAL = 2      # saniye
VPN_INTERVAL = 5
SYSTEM_INTERVAL = 5

# CPU / MEM / TEMP eşikleri. Gösterge, değer SUSTAIN ölçüm boyunca (5 sn × 3 = 15 sn) eşiğin
# üstünde kalınca görünür, aynı süre altında kalınca gizlenir: kısa sıçramalarda yanıp sönmez.
SYSTEM_LIMITS = {"cpu": 80, "mem": 85, "temp": 85}    # %, %, °C
SUSTAIN = 3

PP_NAME = "net.hadess.PowerProfiles"   # tuned-ppd bu arayüzü sunar (şifre istemez)
PP_PATH = "/net/hadess/PowerProfiles"
POWER_LABELS = {"power-saver": "ECO", "performance": "PERF"}

# Varsayılan rota bu arayüzlerden birinden geçiyorsa trafik bir VPN'den akıyordur.
VPN_DEV_RE = re.compile(r"^(tun|tap|wg|ppp|tailscale|cscotun|nordlynx|proton|mullvad)")


def emit(state, last):
    """Durum değiştiyse Waybar'a bir JSON satırı yazar; yeni durumu döndürür."""
    if state != last:
        print(json.dumps(state), flush=True)
    return state


def run(cmd, timeout=3):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 else None


def run_json(cmd):
    out = run(cmd)
    try:
        return json.loads(out) if out else None
    except ValueError:
        return None


# ── Gizlilik: mikrofon, kamera, ekran paylaşımı ───────────────────────────

# pavucontrol'ün seviye göstergeleri de kayıt akışı açar; bunlar mikrofon kullanımı sayılmaz.
METER_BINARIES = {"pavucontrol", "pwvucontrol"}


def mic_users(outputs, sources):
    """Mikrofonu kullanan uygulamalar. outputs/sources: `pactl -f json list ...` çıktısı.
    Sayılmayanlar: duraklatılmış (corked) akışlar, hoparlör çıkışını dinleyenler (.monitor),
    ses seviyesi göstergeleri."""
    monitors = {s["index"] for s in sources if s.get("name", "").endswith(".monitor")}
    users = []
    for so in outputs:
        props = so.get("properties", {})
        if so.get("corked") or so.get("source") in monitors:
            continue
        if (props.get("application.process.binary") in METER_BINARIES
                or props.get("media.name") == "Peak detect"):
            continue
        name = props.get("application.name") or props.get("node.name") or "unknown"
        if name not in users:
            users.append(name)
    return users


def camera_users():
    """/dev/video* aygıtlarından birini açık tutan süreçlerin adları (aynı kullanıcı)."""
    cams = [n for n in os.listdir("/dev") if n.startswith("video")]
    if not cams:
        return []
    if not os.path.isdir("/proc/self/fd"):
        return camera_users_fstat(cams)
    users = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if target.startswith("/dev/video"):
                try:
                    with open(f"/proc/{pid}/comm") as f:
                        name = f.read().strip()
                except OSError:
                    name = pid
                if name not in users:
                    users.append(name)
                break
    return users


def camera_users_fstat(cams):
    """FreeBSD (/proc yok, webcamd'nin /dev/videoN'i): fstat aygıtı açan süreçleri listeler.
    Çıktı: USER CMD PID FD … (ilk satır başlık)."""
    out = run(["fstat", *(f"/dev/{c}" for c in cams)]) or ""
    users = []
    for line in out.splitlines()[1:]:
        f = line.split()
        if len(f) > 2 and f[1] not in users and f[1] != "webcamd":
            users.append(f[1])
    return users


class NiriCasts:
    """niri'nin şu an yaptığı ekran yayınları (portal üzerinden ekran paylaşımı).

    Tek bağlantı açık tutulur ve her soruda yeniden kullanılır (niri bir bağlantıda art arda
    istek kabul eder). Eskiden her 2 saniyede yeni bağlantı açılıp kapanıyordu: FreeBSD'de
    niri 26.04'ün kullandığı calloop 0.14.4'te kapanan her bağlantı kqueue'da bir fd numarası
    "kirletiyor" ve niri sonunda `AlreadyExists` ile çöküyordu (calloop 0.14.5'te düzeldi).
    Bağlantı kurulamazsa giderek seyrekleşen aralıklarla (en çok 60 s) yeniden denenir."""

    def __init__(self):
        self.sock = None
        self.reader = None
        self.retry_at = 0.0
        self.backoff = 5.0

    def close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = self.reader = None

    def fail(self):
        self.close()
        self.retry_at = time.monotonic() + self.backoff
        self.backoff = min(self.backoff * 2, 60.0)

    def get(self):
        path = os.environ.get("NIRI_SOCKET")
        if not path:
            return []
        if self.sock is None:
            if time.monotonic() < self.retry_at:
                return []
            try:
                self.sock = socket.socket(socket.AF_UNIX)
                self.sock.settimeout(2)
                self.sock.connect(path)
                self.reader = self.sock.makefile("rb")
            except OSError:
                self.fail()
                return []
        try:
            self.sock.sendall(b'"Casts"\n')
            line = self.reader.readline()
            if not line:
                raise OSError("niri closed the connection")
            reply = json.loads(line)
        except (OSError, ValueError):
            self.fail()
            return []
        self.backoff = 5.0
        return reply.get("Ok", {}).get("Casts", []) or []


def cast_target(cast):
    """niri'nin yayın kaydı → "screen eDP-1" / "a window"; izleyen yoksa "(paused)".
    Gizlilik için temkinli: duraklatılmış yayın da SCR olarak gösterilir."""
    target = cast.get("target") or {}
    if "Output" in target:
        desc = f"screen {target['Output'].get('name', '?')}"
    elif "Window" in target:
        desc = "a window"
    else:
        desc = "not chosen yet"
    return desc if cast.get("is_active", True) else f"{desc} (paused)"


def privacy_state(mic, cam, casts):
    parts, tips, classes = [], [], []
    if mic:
        parts.append("MIC"); classes.append("mic")
        tips.append("Microphone: " + ", ".join(mic))
    if cam:
        parts.append("CAM"); classes.append("cam")
        tips.append("Camera: " + ", ".join(cam))
    if casts:
        parts.append("SCR"); classes.append("scr")
        tips.append("Screen sharing: " + ", ".join(cast_target(c) for c in casts))
    if not parts:
        return {"text": ""}
    return {"text": " ".join(parts), "tooltip": "\n".join(tips), "class": classes}


INHIBITOR = "screen-sharing"     # swaync engelleyicisinin adı (swaync-client -In ile görülür)


def inhibit_change(was_sharing, sharing):
    """Ekran paylaşımı başlayınca/bitince swaync'e ne denecek: "add", "remove" ya da None."""
    if sharing and not was_sharing:
        return "add"
    if was_sharing and not sharing:
        return "remove"
    return None


def set_inhibitor(change):
    # Ekran paylaşılırken açılır bildirimler gösterilmez (sunumda/toplantıda başkası görmesin);
    # bildirimler yine panelde birikir. swaync yoksa (mako) swaync-client da yoktur.
    if change:
        run(["swaync-client", "-Ia" if change == "add" else "-Ir", INHIBITOR])


def cmd_privacy():
    last = None
    sharing = False
    set_inhibitor("remove")      # önceki çalışmadan kalmış olabilir (Waybar modülü yeniden başlattı)
    niri = NiriCasts()
    while True:
        outputs = run_json(["pactl", "-f", "json", "list", "source-outputs"]) or []
        sources = run_json(["pactl", "-f", "json", "list", "sources", "short"]) or []
        casts = niri.get()
        set_inhibitor(inhibit_change(sharing, bool(casts)))
        sharing = bool(casts)
        last = emit(privacy_state(mic_users(outputs, sources), camera_users(), casts), last)
        time.sleep(PRIVACY_INTERVAL)


# ── Mikrofon sessizde ─────────────────────────────────────────────────────
# Waybar'ın wireplumber modülü boş format'ta gizlenmiyor (boş bir kutu olarak yer kaplıyor);
# bu yüzden ayrı bir modül. pactl subscribe ile yalnızca değişiklik olunca bakar.

def die_with_parent():
    """Alt süreç, bu script ölünce (ör. Waybar çökünce) kendisi de kapansın."""
    import ctypes
    import signal
    libc = ctypes.CDLL(None, use_errno=True)
    if hasattr(libc, "prctl"):                       # Linux
        libc.prctl(1, signal.SIGTERM)                # PR_SET_PDEATHSIG
    elif hasattr(libc, "procctl"):                   # FreeBSD: procctl(P_PID, 0, PROC_PDEATHSIG_CTL)
        sig = ctypes.c_int(signal.SIGTERM)
        libc.procctl(0, 0, 11, ctypes.byref(sig))


def mic_state(wpctl_out):
    """wpctl_out: `wpctl get-volume @DEFAULT_AUDIO_SOURCE@` çıktısı (mikrofon yoksa None)."""
    if not wpctl_out or "[MUTED]" not in wpctl_out:
        return {"text": ""}
    return {"text": "<span alpha='55%'>MIC</span> off", "class": "muted",
            "tooltip": "Microphone muted\nClick: unmute"}


def cmd_mic():
    last = None
    if FREEBSD and run(["pactl", "info"]) is None:
        while True:                 # PulseAudio yok: FreeBSD mikseri
            muted = mixer_muted(run(["mixer", "mic.mute"]), "mic")
            last = emit(mic_state("Volume: 0 [MUTED]" if muted else None), last)
            time.sleep(2)
    while True:
        last = emit(mic_state(run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"])), last)
        try:
            proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True, preexec_fn=die_with_parent)
        except OSError:
            time.sleep(5)
            continue
        # "Event 'change' on source #79" (sessiz/ses) · "... on server" (varsayılan mikrofon değişti)
        for line in proc.stdout:
            if " on source #" in line or " on server" in line:
                last = emit(mic_state(run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"])), last)
        proc.wait()
        time.sleep(2)   # PipeWire yeniden başladıysa biraz bekle, sonra yeniden abone ol


# ── Çökmüş servisler ──────────────────────────────────────────────────────
# Waybar 0.14'ün systemd-failed-units modülü bir kez gizlendikten sonra bir daha görünmüyor
# (test edildi); bu yüzden ayrı bir modül. systemd'nin NFailedUnits özelliği değişince sinyal
# gelir; yeniden başlayan servisler bir anlık "failed" görünmesin diye 1 sn beklenir.

def failed_state(system_units, user_units):
    units = list(system_units) + [f"{u} (user)" for u in user_units]
    if not units:
        return {"text": ""}
    return {"text": f"FAIL {len(units)}", "class": "failed",
            "tooltip": "Failed: " + ", ".join(units) + "\nClick: details"}


def cmd_failed():
    Gio, GLib = gio()
    managers = []
    for bus in (Gio.BusType.SYSTEM, Gio.BusType.SESSION):
        try:
            managers.append(Gio.DBusProxy.new_for_bus_sync(
                bus, Gio.DBusProxyFlags.NONE, None, "org.freedesktop.systemd1",
                "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager", None))
        except GLib.Error:
            managers.append(None)
    last, pending = None, False

    def failed_units(proxy):
        if proxy is None:
            return []
        try:
            units = proxy.call_sync("ListUnitsFiltered", GLib.Variant("(as)", (["failed"],)),
                                    Gio.DBusCallFlags.NONE, 3000, None).unpack()[0]
        except GLib.Error:
            return []
        return sorted(u[0] for u in units)

    def update():
        nonlocal last, pending
        pending = False
        last = emit(failed_state(*(failed_units(m) for m in managers)), last)
        return False

    def changed(proxy, props, _invalidated):
        nonlocal pending
        if "NFailedUnits" in props.keys() and not pending:
            pending = True
            GLib.timeout_add(1000, update)

    for m in managers:
        if m is not None:
            m.connect("g-properties-changed", changed)
    update()
    GLib.MainLoop().run()


# ── Sistem: CPU / MEM / TEMP ──────────────────────────────────────────────
# Waybar'ın cpu/temperature modülleri anlık değere bakıyor; bu laptop kısa yüklerde hemen
# 85 °C'yi geçtiği için gösterge yanıp sönüyordu. Burada değer bir süre yüksek kalmalı.

class Sustained:
    """Son SUSTAIN ölçümün hepsi eşiğin üstündeyse açılır, hepsi altındaysa kapanır."""

    def __init__(self, limit):
        self.limit, self.samples, self.on = limit, [], False

    def add(self, value):
        self.samples = (self.samples + [value])[-SUSTAIN:]
        if len(self.samples) == SUSTAIN:
            if all(v >= self.limit for v in self.samples):
                self.on = True
            elif all(v < self.limit for v in self.samples):
                self.on = False
        return self.on


def sysctl(*names):
    """FreeBSD: sysctl değerleri (metin), bulunamayan None."""
    values = {}
    for name in names:
        out = run(["sysctl", "-n", name])
        values[name] = out.strip() if out else None
    return values


def cpu_times():
    if FREEBSD:
        # kern.cp_time: user nice sys intr idle
        fields = [int(x) for x in sysctl("kern.cp_time")["kern.cp_time"].split()]
        return sum(fields), fields[4]
    with open("/proc/stat") as f:
        fields = [int(x) for x in f.readline().split()[1:]]
    idle = fields[3] + fields[4]          # idle + iowait
    return sum(fields), idle


def mem_percent():
    if FREEBSD:
        v = sysctl("vm.stats.vm.v_page_count", "vm.stats.vm.v_free_count",
                   "vm.stats.vm.v_inactive_count", "vm.stats.vm.v_cache_count")
        total = int(v["vm.stats.vm.v_page_count"])
        free = sum(int(v[k] or 0) for k in list(v)[1:])     # boş + pasif + önbellek ≈ MemAvailable
        return 100 * (1 - free / total)
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":")
            info[key] = int(value.split()[0])
    return 100 * (1 - info["MemAvailable"] / info["MemTotal"])


def freebsd_temp():
    """İşlemci sıcaklığı: coretemp (kldload coretemp) ya da ACPI termal bölgesi; "45.0C"."""
    for name in ("dev.cpu.0.temperature", "hw.acpi.thermal.tz0.temperature"):
        value = sysctl(name)[name]
        m = re.match(r"(-?[\d.]+)C", value or "")
        if m:
            return float(m.group(1))
    return None


def temp_sensor():
    """İşlemci paketi sıcaklığı dosyası (coretemp; yoksa x86_pkg_temp termal bölgesi)."""
    import glob
    for path in sorted(glob.glob("/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input")):
        return path
    for zone in sorted(glob.glob("/sys/class/thermal/thermal_zone*")):
        try:
            with open(f"{zone}/type") as f:
                if f.read().strip() == "x86_pkg_temp":
                    return f"{zone}/temp"
        except OSError:
            pass
    return None


def system_state(values, active):
    """values: {"cpu": %, "mem": %, "temp": °C} · active: o an gösterilecek anahtarlar."""
    labels = {"cpu": ("CPU", "{:.0f}%"), "mem": ("MEM", "{:.0f}%"), "temp": ("TEMP", "{:.0f}°C")}
    known = [k for k in ("cpu", "mem", "temp") if values.get(k) is not None]
    shown = [k for k in known if k in active]
    if not shown:
        return {"text": ""}
    fmt = lambda k: labels[k][1].format(values[k])
    tip = " · ".join(f"{labels[k][0]} {fmt(k)}" for k in known)
    return {"text": "  ".join(f"<span alpha='55%'>{labels[k][0]}</span> {fmt(k)}" for k in shown),
            "tooltip": tip + "\nClick: system monitor", "class": shown}


def cmd_system():
    watch = {k: Sustained(v) for k, v in SYSTEM_LIMITS.items()}
    sensor = None if FREEBSD else temp_sensor()
    last, prev = None, cpu_times()
    while True:
        time.sleep(SYSTEM_INTERVAL)
        total, idle = cpu_times()
        dt = total - prev[0]
        values = {"cpu": 100 * (1 - (idle - prev[1]) / dt) if dt > 0 else 0.0,
                  "mem": mem_percent(), "temp": None}
        prev = (total, idle)
        if sensor:
            try:
                with open(sensor) as f:
                    values["temp"] = int(f.read()) / 1000
            except (OSError, ValueError):
                pass
        elif FREEBSD:
            values["temp"] = freebsd_temp()
        active = {k for k, w in watch.items() if values[k] is not None and w.add(values[k])}
        # Görünürken değer her ölçümde değişir; gizliyken yalnızca durum değişince yazılır.
        last = emit(system_state(values, active), last)


# ── VPN ───────────────────────────────────────────────────────────────────

def vpn_state(route_dev, cisco_ifaces, nm_active):
    """route_dev: 1.1.1.1'e giden rotanın arayüzü · cisco_ifaces: cscotun* arayüzleri ·
    nm_active: NetworkManager'ın etkin bağlantıları [(ad, tür)].
    Tailscale her zaman açık olabildiği için yalnızca exit node kullanılırken sayılır
    (o zaman varsayılan rota tailscale0'dan geçer)."""
    tips = []
    if cisco_ifaces:
        tips.append(f"Cisco Secure Client ({', '.join(cisco_ifaces)})")
    for name, kind in nm_active:
        if kind in ("vpn", "wireguard"):
            tips.append(f"{name} ({'WireGuard' if kind == 'wireguard' else 'VPN'})")
    if route_dev and VPN_DEV_RE.match(route_dev):
        if route_dev.startswith("tailscale"):
            tips.append("Tailscale exit node")
        elif not any(route_dev in t for t in tips):
            tips.append(f"All traffic via {route_dev}")
    if not tips:
        return {"text": ""}
    return {"text": "VPN", "tooltip": "\n".join(tips), "class": "on"}


def route_dev():
    if FREEBSD:
        m = re.search(r"interface: (\S+)", run(["route", "-n", "get", "1.1.1.1"]) or "")
        return m.group(1) if m else None
    routes = run_json(["ip", "-j", "route", "get", "1.1.1.1"]) or []
    return routes[0].get("dev") if routes else None


def cisco_ifaces():
    try:
        return sorted(n for n in os.listdir("/sys/class/net") if n.startswith("cscotun"))
    except OSError:
        return []


def nm_active():
    out = run(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]) or ""
    active = []
    for line in out.splitlines():
        # nmcli -t, addaki ':' karakterini '\:' olarak kaçırır; tür son alandır.
        name, _, kind = line.rpartition(":")
        active.append((name.replace("\\:", ":"), kind))
    return active


def cmd_vpn():
    last = None
    while True:
        last = emit(vpn_state(route_dev(), cisco_ifaces(), nm_active()), last)
        time.sleep(VPN_INTERVAL)


# ── Güç profili ───────────────────────────────────────────────────────────

def power_state(profile):
    label = POWER_LABELS.get(profile or "")
    if not label:
        return {"text": ""}
    return {"text": label, "class": profile,
            "tooltip": f"Power profile: {profile}\nClick: back to balanced"}


def gio():
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    return Gio, GLib


def sleep_forever():
    """Bu sistemde karşılığı olmayan modül: gizli kalır, Waybar yeniden başlatmaz."""
    print(json.dumps({"text": ""}), flush=True)
    while True:
        time.sleep(3600)


def cmd_power(args):
    if FREEBSD:
        sleep_forever()             # power-profiles-daemon yok
    Gio, GLib = gio()
    if args[:1] == ["reset"]:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        bus.call_sync(PP_NAME, PP_PATH, "org.freedesktop.DBus.Properties", "Set",
                      GLib.Variant("(ssv)", (PP_NAME, "ActiveProfile", GLib.Variant("s", "balanced"))),
                      None, Gio.DBusCallFlags.NONE, 5000)
        return

    # Profil değişince D-Bus sinyaliyle haber gelir; yoklama yok.
    try:
        proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None, PP_NAME, PP_PATH, PP_NAME, None)
    except GLib.Error:
        sleep_forever()             # sistem D-Bus'ı yok
    last = None

    def update(*_):
        nonlocal last
        value = proxy.get_cached_property("ActiveProfile")
        last = emit(power_state(value.unpack() if value else None), last)

    proxy.connect("g-properties-changed", update)
    proxy.connect("notify::g-name-owner", update)
    update()
    GLib.MainLoop().run()


# ── FreeBSD: ses, parlaklık, ağ ───────────────────────────────────────────
# Waybar'ın wireplumber (PipeWire gerekir), backlight (/sys) ve network (libnl) modüllerinin
# FreeBSD karşılıkları. Görünüm onlarla aynı; birkaç saniyede bir yoklar (değişince yazar).

LABEL = "<span alpha='55%'>{}</span> {}"


def volume_state(backend, vol, muted, device=""):
    if backend is None:
        return {"text": ""}
    text = LABEL.format("VOL", "--" if muted else f"{vol}%")
    return {"text": text, "tooltip": f"{device or 'Sound'}: {vol}%" + (" (muted)" if muted else ""),
            "class": "muted" if muted else ""}


def mixer_value(out, control):
    """`mixer vol.volume vol.mute` çıktısından değer: vol.volume=0.75:0.75 → "0.75"."""
    m = re.search(rf"^{re.escape(control)}=([0-9.]+)", out or "", re.M)
    return m.group(1) if m else None


def mixer_muted(out, device):
    """mixer(8): FreeBSD 15'te "vol.mute=on|off", eskiden "vol.mute=1|0"."""
    m = re.search(rf"^{re.escape(device)}\.mute=(\S+)", out or "", re.M)
    return bool(m) and m.group(1) in ("on", "1")


def read_volume():
    """(arka uç, yüzde, sessiz mi, aygıt) · PipeWire varsa None: Waybar'ın kendi modülü gösterir."""
    if run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]) is not None:
        return None, 0, False, ""
    out = run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
    if out is not None:
        m = re.search(r"(\d+)%", out)
        mute = run(["pactl", "get-sink-mute", "@DEFAULT_SINK@"]) or ""
        return "pactl", int(m.group(1)) if m else 0, "yes" in mute, "PulseAudio"
    out = run(["mixer", "vol.volume", "vol.mute"])
    vol = mixer_value(out, "vol.volume")
    if vol is None:
        return None, 0, False, ""
    dev = run(["sysctl", "-n", "hw.snd.default_unit"])
    return ("mixer", round(float(vol) * 100), mixer_muted(out, "vol"),
            f"pcm{dev.strip()}" if dev else "")


def sink_changed(line):
    """`pactl subscribe` satırı: çıkış aygıtı ya da varsayılan aygıt değişti mi?
    "Event 'change' on sink #0" · "Event 'change' on server" (sink-input = tek uygulama, sayılmaz)."""
    return " on sink " in line or " on server" in line


def cmd_volume():
    """PulseAudio varsa `pactl subscribe` ile değişince hemen yazar (ses tuşu → bar anında);
    yoksa ya da abonelik koparsa birkaç saniyede bir yoklar."""
    import selectors
    last = None
    sub = None
    while True:
        state = read_volume()
        last = emit(volume_state(*state), last)
        if state[0] != "pactl":
            time.sleep(2)
            continue
        if sub is None or sub.poll() is not None:
            try:
                sub = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE,
                                       stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                sub = None
                time.sleep(2)
                continue
        sel = selectors.DefaultSelector()
        sel.register(sub.stdout, selectors.EVENT_READ)
        deadline = time.monotonic() + 10           # bir şey kaçarsa yine de yokla
        while time.monotonic() < deadline:
            if not sel.select(max(0.0, deadline - time.monotonic())):
                break
            line = sub.stdout.readline().decode(errors="replace")
            if not line:                            # PulseAudio kapandı
                sub = None
                time.sleep(1)
                break
            if sink_changed(line):
                time.sleep(0.05)                    # art arda gelen olayları birleştir
                break
        sel.close()


def backlight_state(pct):
    return {"text": ""} if pct is None else {"text": LABEL.format("LCD", f"{pct}%")}


def cmd_backlight():
    last = None
    while True:
        out = run(["backlight", "-q"])
        pct = int(out) if out and out.strip().isdigit() else None
        last = emit(backlight_state(pct), last)
        time.sleep(2)


def network_state(iface, ifconfig):
    """iface: varsayılan rotanın arayüzü (yoksa None) · ifconfig: `ifconfig <iface>` çıktısı."""
    if not iface:
        return {"text": LABEL.format("NET", "off"), "tooltip": "Disconnected"}
    ip = re.search(r"\binet (\S+)", ifconfig or "")
    ssid = re.search(r"\bssid (.+?) channel", ifconfig or "")
    if ssid:
        name = ssid.group(1).strip('"')
        return {"text": LABEL.format("NET", name),
                "tooltip": f"{name}\n{ip.group(1) if ip else ''}  {iface}"}
    return {"text": LABEL.format("NET", "eth"), "tooltip": f"{ip.group(1) if ip else ''}  {iface}"}


def cmd_network():
    last = None
    while True:
        m = re.search(r"interface: (\S+)", run(["route", "-n", "get", "default"]) or "")
        iface = m.group(1) if m else None
        last = emit(network_state(iface, run(["ifconfig", iface]) if iface else None), last)
        time.sleep(5)


# ── Kendi kendini sınama (check.sh) ───────────────────────────────────────

def sustained_trace(limit, values):
    w = Sustained(limit)
    return [w.add(v) for v in values]


def cmd_selftest():
    sources = [{"index": 78, "name": "alsa_output.analog-stereo.monitor"},
               {"index": 79, "name": "alsa_input.analog-stereo"}]
    stream = lambda src, corked=False, **p: {"source": src, "corked": corked, "properties": p}
    cases = [
        (mic_users([], sources), []),
        (mic_users([stream(79, **{"application.name": "Firefox"})], sources), ["Firefox"]),
        (mic_users([stream(79, True, **{"application.name": "Firefox"})], sources), []),
        (mic_users([stream(78, **{"application.name": "OBS"})], sources), []),
        (mic_users([stream(79, **{"application.process.binary": "pavucontrol",
                                  "application.name": "PulseAudio Volume Control"})], sources), []),
        (sink_changed("Event 'change' on sink #0"), True),
        (sink_changed("Event 'change' on server"), True),
        (sink_changed("Event 'change' on sink-input #12"), False),
        (sink_changed("Event 'new' on client #140"), False),
        (mixer_muted("vol.volume=0.50:0.50\nvol.mute=on\n", "vol"), True),
        (mixer_muted("vol.mute=off", "vol"), False),
        (mixer_muted("vol.mute=1", "vol"), True),
        (privacy_state([], [], []), {"text": ""}),
        (privacy_state(["Firefox"], ["brave"], [{}])["text"], "MIC CAM SCR"),
        ([inhibit_change(a, b) for a, b in ((False, True), (True, True), (True, False), (False, False))],
         ["add", None, "remove", None]),
        (privacy_state([], [], [{"target": {"Output": {"name": "eDP-1"}}, "is_active": True},
                                {"target": {"Window": {"id": 7}}, "is_active": False}])["tooltip"],
         "Screen sharing: screen eDP-1, a window (paused)"),
        (vpn_state("wlp58s0", [], [("eduroam", "802-11-wireless"),
                                   ("tailscale0", "tun")]), {"text": ""}),
        (vpn_state("tailscale0", [], [])["tooltip"], "Tailscale exit node"),
        (vpn_state("wlp58s0", ["cscotun0"], [])["tooltip"], "Cisco Secure Client (cscotun0)"),
        (vpn_state("cscotun0", ["cscotun0"], [])["tooltip"], "Cisco Secure Client (cscotun0)"),
        (vpn_state("wg0", [], [("Home", "wireguard")])["tooltip"], "Home (WireGuard)\nAll traffic via wg0"),
        (vpn_state(None, [], [("Work", "vpn")])["text"], "VPN"),
        (mic_state(None), {"text": ""}),
        (mic_state("Volume: 0.11\n"), {"text": ""}),
        (mic_state("Volume: 0.11 [MUTED]\n")["class"], "muted"),
        (failed_state([], []), {"text": ""}),
        (failed_state(["a.service"], ["b.service"])["text"], "FAIL 2"),
        (failed_state([], ["b.service"])["tooltip"], "Failed: b.service (user)\nClick: details"),
        (system_state({"cpu": 95, "mem": 40, "temp": 70}, set()), {"text": ""}),
        (system_state({"cpu": 95, "mem": 40, "temp": 91}, {"cpu", "temp"})["text"],
         "<span alpha='55%'>CPU</span> 95%  <span alpha='55%'>TEMP</span> 91°C"),
        (system_state({"cpu": 95, "mem": 40, "temp": None}, {"cpu", "temp"})["class"], ["cpu"]),
        (sustained_trace(85, [90, 90, 70, 90, 90, 90, 70, 70, 70]),
         [False, False, False, False, False, True, True, True, False]),
        (power_state("balanced"), {"text": ""}),
        (power_state(None), {"text": ""}),
        (power_state("power-saver")["text"], "ECO"),
        (power_state("performance")["text"], "PERF"),
        (mixer_value("vol.volume=0.75:0.75\nvol.mute=1\n", "vol.volume"), "0.75"),
        (mixer_value("vol.volume=0.75:0.75\nvol.mute=1\n", "vol.mute"), "1"),
        (mixer_value("", "vol.mute"), None),
        (volume_state("mixer", 75, False, "pcm0")["text"], "<span alpha='55%'>VOL</span> 75%"),
        (volume_state("mixer", 75, True)["text"], "<span alpha='55%'>VOL</span> --"),
        (volume_state(None, 0, False), {"text": ""}),
        (backlight_state(None), {"text": ""}),
        (backlight_state(40)["text"], "<span alpha='55%'>LCD</span> 40%"),
        (network_state(None, None)["text"], "<span alpha='55%'>NET</span> off"),
        (network_state("wlan0", "wlan0: flags=8843<UP>\n\tinet 192.168.1.5 netmask 0xffffff00\n"
                       "\tssid Home WiFi channel 6 (2437 MHz 11g) bssid 00:11:22:33:44:55\n")["text"],
         "<span alpha='55%'>NET</span> Home WiFi"),
        (network_state("em0", "em0: flags=8843<UP>\n\tinet 10.0.0.2 netmask 0xff000000\n")["tooltip"],
         "10.0.0.2  em0"),
    ]
    failed = 0
    for i, (got, want) in enumerate(cases):
        if got != want:
            failed += 1
            print(f"case {i}: got {got!r}, want {want!r}", file=sys.stderr)
    if failed:
        sys.exit(1)
    print(f"bar-status: {len(cases)} checks ok")


def main():
    args = sys.argv[1:]
    commands = {"privacy": lambda: cmd_privacy(), "mic": lambda: cmd_mic(),
                "failed": lambda: cmd_failed(), "system": lambda: cmd_system(),
                "vpn": lambda: cmd_vpn(),
                "power": lambda: cmd_power(args[1:]), "selftest": lambda: cmd_selftest(),
                "volume": lambda: cmd_volume(), "backlight": lambda: cmd_backlight(),
                "network": lambda: cmd_network()}
    if not args or args[0] not in commands:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(1)
    try:
        commands[args[0]]()
    except (KeyboardInterrupt, BrokenPipeError):
        pass


if __name__ == "__main__":
    main()
