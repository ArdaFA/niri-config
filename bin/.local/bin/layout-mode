#!/usr/bin/env python3
"""layout-mode — niri için otomatik ızgara düzeni (AUTO) ve elle düzen (FREE).

AUTO: her workspace'teki döşeli pencereler en fazla iki sütuna dizilir.
  1 pencere: tam ekran        2: yan yana (%50 / %50)
  3: solda bir, sağda iki     4: 2x2
  5 ve fazlası: iki sütuna dengeli (5 → solda 3, sağda 2); sütun içindekiler eşit yükseklikte.
  - Sıra okuma sırasıdır: sol sütun yukarıdan aşağı, sonra sağ sütun. Yeni pencere sona eklenir.
  - Pencere açılınca, kapanınca ya da workspace değiştirince düzen yeniden kurulur.
  - Bir sütun elle boyutlandırılınca diğeri kalan alana sığar. Super+F / tam ekrana dokunulmaz.
  - `layout-mode move left|right` odaktaki pencereyi yandaki sütundaki komşusuyla değiştirir.
FREE: servis hiçbir şeye dokunmaz; pencereler döşeli kalır, boyut ve sıra elle ayarlanır.
  AUTO'ya dönünce ızgara mevcut sırayla yeniden kurulur.

niri'nin IPC olaylarını dinleyen bir servis olarak çalışır (layout-mode.service).
Mod, Waybar'daki etikete SIGRTMIN+8 ile bildirilir.

Ekrana yazılan her şey İngilizce (arayüz kuralı); açıklamalar Türkçe.
"""

import argparse
import json
import os
import re
import selectors
import signal
import socket
import subprocess
import sys
import time
from collections import deque
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
STATE_FILE = RUNTIME / "layout-mode.json"
CMD_SOCKET = RUNTIME / "layout-mode.sock"
LAYOUT_KDL = Path.home() / ".config/niri/layout.kdl"
WAYBAR_SIGNAL = 8          # config.jsonc → "custom/layout": { "signal": 8 }

SETTLE = 0.15              # son olaydan bu kadar sonra düzenle (saniye)
REALIGN_AFTER_RESIZE = 1.0 # elle boyutlandırmadan sonra görünümü hizalamadan önce bekle (saniye)
RECHECK = 0.6              # hizalamayı bu kadar sonra bir kez daha yap (saniye)
GRACE = 1.0                # istenen genişliğe geçmesi için uygulamaya tanınan süre (saniye)
TOLERANCE_PX = 3           # hedef genişlikten bu kadar sapma "uyuyor" sayılır
MIN_COLUMN_PX = 200        # boyutlandırırken diğer sütun bundan dar olmasın
FULL_SHARE = 0.97          # bundan geniş sütun = büyütülmüş / tam ekran, karışma
MAX_ROUNDS = 4             # yapı değişmeden üst üste en fazla bu kadar genişlik düzeltmesi
MAX_REBUILDS = 3           # aynı pencerelerle en fazla bu kadar yeniden kurma denemesi
PLAN_BUDGET = 4000         # en kısa taşıma sırasını ararken bakılacak en fazla durum


DEBUG = bool(os.environ.get("LAYOUT_MODE_DEBUG"))


def debug(*parts):
    if DEBUG:
        print(f"{time.monotonic():.3f}", *parts, file=sys.stderr, flush=True)


def die(msg):
    print(f"layout-mode: {msg}", file=sys.stderr)
    sys.exit(1)


# ── niri IPC ──────────────────────────────────────────────────────────────

def niri_socket():
    path = os.environ.get("NIRI_SOCKET")
    if not path:
        die("NIRI_SOCKET is not set (is niri running?)")
    return path


def batch(requests):
    """İstekleri tek bağlantıda art arda gönderir; niri hepsini hemen sırayla işler,
    böylece ara durumlar ekrana neredeyse hiç yansımaz. Cevapların "Ok" kısımlarını döndürür."""
    if not requests:
        return []
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(niri_socket())
        s.sendall("".join(json.dumps(r) + "\n" for r in requests).encode())
        f = s.makefile()
        replies = [json.loads(f.readline()) for _ in requests]
    errors = [r["Err"] for r in replies if "Err" in r]
    if errors:
        raise RuntimeError(f"niri: {errors[0]}")
    return [r["Ok"] for r in replies]


def request(req):
    return batch([req])[0]


def act(name, **args):
    """Bir niri eylemi isteği (batch için)."""
    return {"Action": {name: args}}


def action(name, **args):
    request(act(name, **args))


def query(name):
    return request(name)[name]


# ── Düzen hesabı ──────────────────────────────────────────────────────────

def columns(windows, ws_id):
    """Workspace'in döşeli sütunları, soldan sağa: [(anahtar, [pencere id'leri], genişlik)]."""
    cols = {}
    for w in windows:
        pos = w["layout"]["pos_in_scrolling_layout"]
        if w["workspace_id"] != ws_id or w["is_floating"] or not pos:
            continue
        cols.setdefault(pos[0], []).append((pos[1], w["id"], w["layout"]["tile_size"][0]))
    result = []
    for idx in sorted(cols):
        tiles = sorted(cols[idx])
        ids = [t[1] for t in tiles]
        result.append((frozenset(ids), ids, tiles[0][2]))
    return result


def grid(order):
    """Okuma sırasındaki pencerelerden hedef sütunlar: en fazla iki sütun."""
    n = len(order)
    if n <= 1:
        return [list(order)] if order else []
    left = 1 if n == 3 else (n + 1) // 2   # 3'te solda tek büyük pencere, gerisi dengeli
    return [list(order[:left]), list(order[left:])]


def simulate(cols, op, wid):
    """niri'nin consume-or-expel-window-left/right (--id) eyleminin sütunlara etkisi.
    Tek başınaysa yandaki sütunun en altına katılır; sütunda başkaları da varsa
    o yönde kendi sütununa çıkar. Etkisizse None."""
    cols = [list(c) for c in cols]
    ci = next((i for i, c in enumerate(cols) if wid in c), None)
    if ci is None:
        return None
    col = cols[ci]
    if len(col) == 1:
        if op == "L":
            if ci == 0:
                return None
            del cols[ci]
            cols[ci - 1].append(wid)
        else:
            if ci == len(cols) - 1:
                return None
            del cols[ci]
            cols[ci].append(wid)
    else:
        col.remove(wid)
        cols.insert(ci if op == "L" else ci + 1, [wid])
    return tuple(map(tuple, cols))


def plan(current, target):
    """Mevcut sütunlardan hedefe götüren eylem listesi [("L"|"R", pencere id)].
    Önce en kısa yol aranır (genelde 1–3 adım); bulunamazsa her durumda işe yarayan
    uzun yola düşülür: hepsini tek sütunlara ayır, sırala, yeniden birleştir."""
    start = tuple(map(tuple, current))
    goal = tuple(map(tuple, target))
    if start == goal:
        return []
    ids = [w for c in current for w in c]
    prev = {start: None}
    queue = deque([start])
    while queue and len(prev) < PLAN_BUDGET:
        state = queue.popleft()
        for wid in ids:
            for op in "LR":
                nxt = simulate(state, op, wid)
                if nxt is None or nxt in prev:
                    continue
                prev[nxt] = (state, op, wid)
                if nxt == goal:
                    steps = []
                    while prev[nxt] is not None:
                        nxt, op_, wid_ = prev[nxt]
                        steps.append((op_, wid_))
                    return steps[::-1]
                queue.append(nxt)
    return plan_long(current, target)


def plan_long(current, target):
    steps = []
    state = tuple(map(tuple, current))

    def do(op, wid):
        nonlocal state
        state = simulate(state, op, wid)
        steps.append((op, wid))

    # 1. Her pencere kendi sütununa (okuma sırası korunur).
    for col in [list(c) for c in state]:
        for wid in col[:-1]:
            do("L", wid)
    # 2. Tek pencereli sütunları hedef sıraya diz: bir pencere solundakinin altına
    #    katılıp onun soluna çıkınca ikisi yer değiştirir.
    order = [w for c in target for w in c]
    for i, wid in enumerate(order):
        while [c[0] for c in state].index(wid) > i:
            do("L", wid)
            do("L", wid)
    # 3. Hedef sütunları kur: her pencere solundaki sütunun altına katılır.
    for col in target:
        for wid in col[1:]:
            do("L", wid)
    assert state == tuple(map(tuple, target)), "layout plan mismatch"
    return steps


# ── Durum dosyası (Waybar etiketi ve komutlar okur) ────────────────────────

def read_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def daemon_alive(state):
    pid = state.get("pid")
    if not pid:
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    return b"layout-mode" in cmdline


def notify_waybar():
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── Servis ────────────────────────────────────────────────────────────────

class Workspace:
    """Bir workspace için AUTO modunun hatırladıkları."""

    def __init__(self):
        self.order = []         # pencerelerin son okuma sırası (yenileri ayırt etmek için)
        self.rebuild_ids = None # son yeniden kurmadaki pencere kümesi
        self.rebuilds = 0       # aynı kümeyle kaç kez yeniden kurmaya çalışıldı
        self.shares = {}        # sütun anahtarı → hedef pay (toplam 1)
        self.widths = None      # son görülen genişlikler (değişim tespiti için)
        self.rounds = 0
        self.realign_at = None  # görünüm bu andan sonra hizalanacak (time.monotonic)
        self.recheck = False    # ilk hizalama yapıldı, kontrol için bir kez daha yapılacak
        self.pending = set()    # genişliği az önce değiştirilen sütunlar
        self.pending_until = 0  # bu ana kadar onların sapması "henüz geçmedi" sayılır


class Daemon:
    def __init__(self):
        self.mode = "auto"
        self.ws = {}            # workspace id → Workspace
        self.dirty = set()      # düzenlenecek workspace'ler
        self.deadline = None    # bir sonraki düzenleme zamanı
        self.timers = {}        # workspace id → ertelenmiş kontrol zamanı
        self.overview = False
        self.buffer = b""

        old = read_state()
        if old.get("niri") == niri_socket() and old.get("mode") in ("auto", "free"):
            self.mode = old["mode"]   # aynı niri oturumunda yeniden başlatıldı: modu koru

    # ── yardımcılar ──

    def save(self):
        state = {"mode": self.mode, "pid": os.getpid(), "niri": niri_socket()}
        tmp = STATE_FILE.with_name(".layout-mode.json.tmp")
        tmp.write_text(json.dumps(state) + "\n")
        tmp.replace(STATE_FILE)
        notify_waybar()

    def schedule(self, *ws_ids):
        self.dirty.update(i for i in ws_ids if i is not None)
        self.deadline = time.monotonic() + SETTLE

    @staticmethod
    def gaps():
        try:
            m = re.search(r"^\s*gaps\s+([\d.]+)", LAYOUT_KDL.read_text(), re.M)
            if m:
                return float(m.group(1))
        except OSError:
            pass
        return 12.0

    # ── olaylar ──

    def on_event(self, event):
        kind, data = next(iter(event.items()))
        if kind == "WindowsChanged":
            self.schedule(*(w["workspace_id"] for w in data["windows"]))
        elif kind == "WindowOpenedOrChanged":
            # Pencere başka workspace'e geçmiş olabilir; eskisini bilmediğimiz için hepsine
            # bakılır (ucuz: değişmeyen workspace'te yalnızca karşılaştırma yapılır).
            self.schedule(data["window"]["workspace_id"], *self.ws)
        elif kind in ("WindowClosed", "WindowLayoutsChanged"):
            self.schedule(*self.ws)
        elif kind == "WorkspacesChanged":
            alive = {w["id"] for w in data["workspaces"]}
            self.ws = {i: s for i, s in self.ws.items() if i in alive}
            self.schedule(*alive)
        elif kind == "WorkspaceActivated":
            self.schedule(data["id"])
        elif kind == "OverviewOpenedOrClosed":
            self.overview = data["is_open"]
            if not self.overview:
                self.schedule(*self.ws)

    def on_command(self, cmd):
        target = {"toggle": "free" if self.mode == "auto" else "auto",
                  "auto": "auto", "free": "free"}.get(cmd)
        if target and target != self.mode:
            self.mode = target
            # AUTO'ya dönüşte her workspace sıfırdan: ızgara mevcut okuma sırasıyla kurulur.
            self.ws, self.timers = {}, {}
            self.save()
            self.schedule(*(w["id"] for w in query("Workspaces")))
            debug("mode", self.mode)

    # ── düzenleme ──

    def settle(self):
        self.deadline = None
        dirty, self.dirty = self.dirty, set()
        if self.mode != "auto":
            return
        windows = query("Windows")
        if any(w["workspace_id"] is None and not w["is_floating"] for w in windows):
            # Bir pencere fareyle taşınıyor (Super+sol tık): bırakılınca yeniden bakılır.
            self.dirty |= dirty
            return
        workspaces = {w["id"]: w for w in query("Workspaces")}
        outputs = query("Outputs")
        focused = (query("FocusedWindow") or {}).get("id")
        for ws_id in sorted(dirty):
            ws = workspaces.get(ws_id)
            if ws is None or ws["output"] not in outputs or not outputs[ws["output"]].get("logical"):
                continue
            self.balance(ws, windows, outputs[ws["output"]]["logical"]["width"], focused)

    def balance(self, ws, windows, width, focused):
        st = self.ws.setdefault(ws["id"], Workspace())
        cols = columns(windows, ws["id"])
        if not cols:
            self.ws[ws["id"]] = Workspace()
            return
        now = time.monotonic()

        # ── 1. Yapı: pencereler doğru sütunlarda mı? ──
        current = [ids for _, ids, _ in cols]
        order = [w for ids in current for w in ids]
        known = set(st.order)
        # Bilinenler bulundukları sırada kalır; yeni gelenler (açılan ya da başka
        # workspace'ten gelen) sona eklenir.
        order = [w for w in order if w in known] + [w for w in order if w not in known]
        st.order = order
        target = grid(order)
        if current != target:
            ids = frozenset(order)
            if ids != st.rebuild_ids:
                st.rebuild_ids, st.rebuilds = ids, 0
            st.rebuilds += 1
            if st.rebuilds > MAX_REBUILDS:
                debug("ws", ws["id"], "rebuild keeps failing, giving up", current)
                return
            steps = plan(current, target)
            debug("ws", ws["id"], "rebuild", current, "->", target, "steps", steps)
            moves = [act("ConsumeOrExpelWindowLeft" if op == "L" else "ConsumeOrExpelWindowRight",
                         id=wid) for op, wid in steps]
            self.equalize(ws["id"], st, target, now, moves)
            return

        # ── 2. Genişlikler: sütunlar ekranı tam dolduruyor mu? ──
        g = self.gaps()
        span = width - g                     # niri: genişlik = span * pay - g
        keys = [c[0] for c in cols]
        widths = [c[2] for c in cols]
        changed = widths != st.widths
        st.widths = widths

        if set(keys) != set(st.shares):
            # Sütunların üyeleri değişti (ör. iki pencere yer değiştirdi): eşit böl.
            debug("ws", ws["id"], "members changed, equal split")
            self.equalize(ws["id"], st, current, now)
            return

        actual = {c[0]: (c[2] + g) / span for c in cols}
        tol = TOLERANCE_PX / span
        off = [k for k in keys if abs(actual[k] - st.shares[k]) > tol]
        debug("ws", ws["id"], "widths", widths, "off", [sorted(k) for k in off])

        if off and now < st.pending_until and set(off) <= st.pending:
            # Az önce genişliğini değiştirdiğimiz pencere henüz yeni boyuta geçmedi: bekle.
            self.timers[ws["id"]] = min(st.pending_until, now + 2 * SETTLE)
            return

        if not off:
            st.rounds = 0
            st.pending = set()
            if changed and st.realign_at is None:
                st.realign_at = now       # ör. büyütülen sütun eski haline döndü
            if st.realign_at is not None and len(cols) > 1:
                if now < st.realign_at:
                    self.timers[ws["id"]] = st.realign_at
                elif self.realign(ws, cols, focused):
                    # Pencereler yeni boyutlarına geç geçebiliyor; bir kez daha hizala.
                    # Zaten hizalıysa ikinci deneme görünmez.
                    if st.recheck:
                        st.realign_at, st.recheck = None, False
                    else:
                        st.realign_at, st.recheck = now + RECHECK, True
                        self.timers[ws["id"]] = st.realign_at
            elif len(cols) == 1:
                st.realign_at = None
            return

        if any(actual[k] > FULL_SHARE for k in off):
            # Büyütülmüş ya da tam ekran: bilerek taşıyor. Geri dönünce hizalanır.
            st.realign_at = now
            return
        if len(keys) == 1:
            # Tek sütunu elle küçülttün: kalan yeri dolduracak başka sütun yok, olduğu gibi kalır.
            st.shares = {keys[0]: actual[keys[0]]}
            return

        st.rounds += 1
        if st.rounds > MAX_ROUNDS:
            return  # uyuşmuyor (ör. uygulamanın en küçük genişliği); yapı değişene kadar dur

        # Hedefinden sapan sütun ya elle boyutlandırıldı ya da istenen genişliğe
        # inemedi: o genişlikte sabitlenir, diğeri kalan alanı alır.
        fixed = {k: actual[k] for k in off}
        others = [k for k in keys if k not in fixed]
        if not others:
            st.shares = dict(actual)
            return
        min_share = (MIN_COLUMN_PX + g) / span
        free = 1 - sum(fixed.values())
        if free < min_share * len(others):
            # Çok büyütüldü: diğeri en dar haline iner, büyütülen sütun geri çekilir.
            user = next((k for k in off if focused in k), off[0])
            fixed[user] = max(min_share, fixed[user] - (min_share * len(others) - free))
            free = 1 - sum(fixed.values())
        base = sum(st.shares[k] for k in others) or 1
        shares = {k: st.shares[k] * free / base for k in others}
        shares.update(fixed)
        # Sabitlenen sütunlara yalnızca geri çekildiyse dokunulur: niri, boyutlandırılan
        # sütunun genişliği dışarıdan değişirse fareyle sürüklemeyi bırakır.
        reqs, applied = [], set()
        for key, ids, _ in cols:
            if key in fixed and abs(fixed[key] - actual[key]) <= tol:
                continue
            reqs.append(act("SetWindowWidth", id=ids[0],
                            change={"SetProportion": round(shares[key] * 100, 4)}))
            applied.add(key)
        batch(reqs)
        st.pending, st.pending_until = applied, now + GRACE
        st.shares = shares
        # Hizalama başka sütuna odaklanmayı gerektirir; bu da süren bir sürüklemeyi keser.
        # Bu yüzden fare bir süre durduktan sonra yapılır.
        st.realign_at, st.recheck = now + REALIGN_AFTER_RESIZE, False
        self.timers[ws["id"]] = st.realign_at

    def equalize(self, ws_id, st, cols, now, moves=()):
        """(İsteğe bağlı taşımalardan sonra) sütunları eşit genişliğe, pencereleri sütun
        içinde eşit yüksekliğe getirir; hepsi tek seferde gönderilir."""
        share = 1 / len(cols)
        reqs = list(moves)
        reqs += [act("SetWindowWidth", id=col[0], change={"SetProportion": round(share * 100, 4)})
                 for col in cols]
        reqs += [act("ResetWindowHeight", id=wid) for col in cols if len(col) > 1 for wid in col]
        batch(reqs)
        st.shares = {frozenset(col): share for col in cols}
        st.pending, st.pending_until = set(st.shares), now + GRACE
        st.rounds = 0
        st.realign_at, st.recheck = now, False
        # Genişlikler zaten eşitse niri olay göndermez; hizalama için yine de bakılır.
        self.timers[ws_id] = now + 2 * SETTLE

    def realign(self, ws, cols, focused):
        """Görünümü şeridin başına hizalar. niri'de görünümü doğrudan ayarlayan bir komut yok;
        son ve ilk sütuna odaklanıp eski pencereye dönmek görünümü yerine oturtuyor.
        Alt+Tab listesi bu ara odakları görmez (recent-windows debounce 750 ms)."""
        if self.overview or not ws["is_active"]:
            return False
        if focused is None and not ws["is_focused"]:
            return False  # odak başka monitörde ama pencere yok: geri dönülemez
        debug("ws", ws["id"], "realign", [c[1][0] for c in cols], "focus", focused)
        batch([act("FocusWindow", id=wid)
               for wid in (cols[-1][1][0], cols[0][1][0], focused) if wid is not None])
        return True

    # ── ana döngü ──

    def run(self):
        events = socket.socket(socket.AF_UNIX)
        events.connect(niri_socket())
        events.sendall(b'"EventStream"\n')

        CMD_SOCKET.unlink(missing_ok=True)
        commands = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        commands.bind(str(CMD_SOCKET))

        sel = selectors.DefaultSelector()
        sel.register(events, selectors.EVENT_READ, "events")
        sel.register(commands, selectors.EVENT_READ, "commands")
        self.save()
        try:
            first = True
            while True:
                now = time.monotonic()
                for ws_id in [i for i, t in self.timers.items() if t <= now]:
                    del self.timers[ws_id]
                    self.dirty.add(ws_id)
                    self.deadline = self.deadline or now
                wake = [t for t in (self.deadline, *self.timers.values()) if t is not None]
                timeout = max(0.0, min(wake) - now) if wake else None
                for key, _ in sel.select(timeout):
                    if key.data == "commands":
                        cmd = commands.recv(64).decode(errors="replace").strip()
                        try:
                            self.on_command(cmd)
                        except (OSError, RuntimeError, KeyError) as e:
                            print(f"layout-mode: {e}", file=sys.stderr, flush=True)
                        continue
                    chunk = events.recv(65536)
                    if not chunk:
                        return  # niri kapandı
                    self.buffer += chunk
                    *lines, self.buffer = self.buffer.split(b"\n")
                    for line in lines:
                        if first:            # ilk satır isteğin cevabı: {"Ok":"Handled"}
                            first = False
                            continue
                        if line.strip():
                            self.on_event(json.loads(line))
                if self.deadline is not None and time.monotonic() >= self.deadline:
                    try:
                        self.settle()
                    except (OSError, RuntimeError, KeyError) as e:
                        print(f"layout-mode: {e}", file=sys.stderr, flush=True)
        finally:
            CMD_SOCKET.unlink(missing_ok=True)


# ── Komutlar ──────────────────────────────────────────────────────────────

def cmd_daemon(_args):
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    Daemon().run()


def send(cmd):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
        try:
            s.sendto(cmd.encode(), str(CMD_SOCKET))
        except OSError:
            die("the layout service is not running (systemctl --user status layout-mode)")


def cmd_send(args):
    send(args.command)


def cmd_move(args):
    """AUTO'da: odaktaki pencereyi yandaki sütunda aynı satırdaki pencereyle değiştirir.
    Yanda sütun yoksa pencere o yöndeki monitöre gider.
    FREE'de ya da servis kapalıyken niri'nin olağan sütun taşıma eylemi."""
    left = args.direction == "left"
    native = "MoveColumnLeftOrToMonitorLeft" if left else "MoveColumnRightOrToMonitorRight"
    state = read_state()
    if not (daemon_alive(state) and state.get("mode") == "auto"):
        action(native)
        return
    windows = query("Windows")
    me = next((w for w in windows if w["is_focused"]), None)
    pos = me and me["layout"]["pos_in_scrolling_layout"]
    if not pos or me["is_floating"]:
        action(native)
        return
    cols = [ids for _, ids, _ in columns(windows, me["workspace_id"])]
    col, row = pos[0] - 1, pos[1] - 1
    other = col + (-1 if left else 1)
    if not 0 <= other < len(cols):
        action("MoveWindowToMonitorLeft" if left else "MoveWindowToMonitorRight")
        return
    partner = cols[other][min(row, len(cols[other]) - 1)]
    # swap-window-left/right, yandaki sütunun etkin penceresiyle yer değiştirir:
    # önce eşini etkin yap, sonra odağı geri al.
    batch([act("FocusWindow", id=partner), act("FocusWindow", id=me["id"]),
           act("SwapWindowLeft" if left else "SwapWindowRight")])


def cmd_selftest(_args):
    """check.sh için: planlayıcıyı rastgele düzenlerle dener (niri gerekmez)."""
    import random
    rng = random.Random(7)
    for _ in range(100):
        n = rng.randint(1, 8)
        ids = list(range(1, n + 1))
        rng.shuffle(ids)
        cols, i = [], 0
        while i < n:
            k = rng.randint(1, n - i)
            cols.append(ids[i:i + k])
            i += k
        target = grid(rng.sample(ids, n))
        for steps in (plan(cols, target), plan_long(cols, target)):
            state = tuple(map(tuple, cols))
            for op, wid in steps:
                state = simulate(state, op, wid)
            if state != tuple(map(tuple, target)):
                die(f"plan failed: {cols} -> {target}")
    print("layout planner ok")


def cmd_status(_args):
    state = read_state()
    print(state.get("mode", "auto") if daemon_alive(state) else "off")


def cmd_label(_args):
    """Waybar "custom/layout" modülü için JSON."""
    state = read_state()
    if not daemon_alive(state):
        out = {"text": "----", "class": "off", "tooltip": "Layout service is not running"}
    elif state.get("mode") == "free":
        out = {"text": "FREE", "class": "free",
               "tooltip": "Manual layout: windows stay where you put them.\n"
                          "Super+T or click: auto layout"}
    else:
        out = {"text": "AUTO", "class": "auto",
               "tooltip": "Auto layout: windows tile in a two-column grid.\n"
                          "Super+Ctrl+Arrows: swap windows · Super+T or click: manual layout"}
    print(json.dumps(out))


def main():
    parser = argparse.ArgumentParser(
        prog="layout-mode",
        description="Automatic grid layout (AUTO) and manual layout (FREE) for niri.")
    sub = parser.add_subparsers(dest="cmd", metavar="<command>")
    for name, text in (("toggle", "switch between AUTO and FREE"),
                       ("auto", "switch to the automatic grid layout"),
                       ("free", "switch to manual layout (stop arranging windows)")):
        sub.add_parser(name, help=text).set_defaults(func=cmd_send, command=name)
    move = sub.add_parser("move", help="AUTO: swap the focused window with its neighbor; "
                                       "FREE: move the column")
    move.add_argument("direction", choices=("left", "right"))
    move.set_defaults(func=cmd_move)
    sub.add_parser("status", help="print the current mode").set_defaults(func=cmd_status)
    sub.add_parser("label").set_defaults(func=cmd_label)     # Waybar için, listede görünmez
    sub.add_parser("daemon").set_defaults(func=cmd_daemon)   # systemd servisi çalıştırır
    sub.add_parser("selftest").set_defaults(func=cmd_selftest)  # check.sh çalıştırır
    args = parser.parse_args()
    if not getattr(args, "func", None):
        parser.print_help()
        sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
