#!/bin/sh
# night-light — gece ışığı: ekran renklerini sıcak tona çeker (wlsunset, night-light.service).
# Açıkken gün içinde de sıcak kalır. Sıcaklık: Settings → Displays. Oturumdan çıkınca kapanır.
#
# Otomatik (Settings → Displays → "Turn on automatically", services.env → NIGHT_AUTO=1):
# night-light-auto.timer 19:00'da açar, 07:00'de kapatır; oturum açılışında saate göre
# ayarlar. Arada elle açıp kapatmak serbest; bir sonraki geçişe kadar geçerli.
#
#   night-light on | off | toggle
#   night-light auto        otomatik açıksa saate göre aç/kapat (zamanlayıcı ve oturum açılışı)
#   night-light status      true / false (hızlı ayarlar düğmesi)
#   night-light label       Waybar modülü için JSON; kapalıyken boş (modül gizlenir)
#
# wlsunset kurulu değilse "on" bir bildirimle kurulum komutunu söyler.
# Ekrana yazılanlar İngilizce (arayüz kuralı); açıklamalar Türkçe.

set -u

UNIT=night-light.service
SIGNAL=10   # Waybar config.jsonc → custom/night → "signal"
# Saatleri değiştirmek: buradaki iki değer + night-light-auto.timer + settings → NIGHT_FROM/UNTIL
ON_AT=1900
OFF_AT=0700

# Settings'in yazdığı dosya (ANAHTAR=değer satırları); yoksa otomatik kapalı.
NIGHT_AUTO=0
ENV_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/settings/services.env"
# shellcheck disable=SC1090
[ -r "$ENV_FILE" ] && . "$ENV_FILE"

evening() {
    now=$(date +%H%M)
    [ "$now" -ge "$ON_AT" ] || [ "$now" -lt "$OFF_AT" ]
}

is_on() {
    systemctl --user --quiet is-active "$UNIT"
}

refresh_bar() {
    pkill "-RTMIN+$SIGNAL" -x waybar 2>/dev/null || true
}

turn_on() {
    if ! command -v wlsunset >/dev/null 2>&1; then
        notify-send --app-name="Night light" "Night light needs wlsunset" \
            "Install it with: sudo dnf install wlsunset" 2>/dev/null
        echo "night-light: wlsunset is not installed (sudo dnf install wlsunset)" >&2
        exit 1
    fi
    systemctl --user start "$UNIT"
    refresh_bar
}

turn_off() {
    systemctl --user stop "$UNIT"
    refresh_bar
}

case "${1:-}" in
    on)      turn_on ;;
    off)     turn_off ;;
    toggle)  if is_on; then turn_off; else turn_on; fi ;;
    status)  if is_on; then echo true; else echo false; fi ;;
    auto)
        [ "$NIGHT_AUTO" = 1 ] || exit 0
        if evening; then turn_on; else turn_off; fi ;;
    label)
        if is_on; then
            if [ "$NIGHT_AUTO" = 1 ]; then
                printf '%s\n' '{"text":"NIGHT","class":"on","tooltip":"Night light: warm screen colors\nTurns off by itself at 07:00\nClick: turn off"}'
            else
                printf '%s\n' '{"text":"NIGHT","class":"on","tooltip":"Night light: warm screen colors\nClick: turn off"}'
            fi
        else
            printf '%s\n' '{"text":""}'
        fi ;;
    *)
        echo "Usage: night-light on|off|toggle|auto|status|label" >&2
        exit 1 ;;
esac
