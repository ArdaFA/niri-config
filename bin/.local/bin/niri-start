#!/bin/sh
# niri-start — niri'yi metin konsolundan (giriş ekranı olmadan) başlatır.
#
#   ~/.local/bin/niri-start
#
# Önce sık takılınan şeyleri kontrol eder ve ne yapılacağını yazar (FreeBSD: seatd, video
# grubu, grafik sürücüsü). Sonra:
#   systemd'li Linux (Fedora):  niri-session  (giriş ekranından girmekle aynı)
#   FreeBSD ve diğerleri:       ck-launch-session dbus-run-session niri --session
#     ck-launch-session (ConsoleKit2, FreeBSD'de polkit'le gelir): yönetici şifresi soran
#     pencere (polkit) ancak bir ConsoleKit oturumunun içinde çalışır.
# niri'nin çıktısı ~/.local/state/niri-session/niri.log dosyasına gider, konsola değil.
# Ekrana yazılanlar İngilizce (arayüz kuralı); açıklamalar Türkçe.

set -u

if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${NIRI_SOCKET:-}" ]; then
    echo "niri-start: already inside a graphical session; run it from a text console (Ctrl+Alt+F2)." >&2
    exit 1
fi

problems=0
problem() {
    problems=$((problems + 1))
    printf '\n  - %s\n' "$1" >&2
    shift
    for line in "$@"; do printf '      %s\n' "$line" >&2; done
}

# Wayland programları buraya soket açar. FreeBSD'de pam_xdg, Linux'ta logind ayarlar;
# yine de yoksa kullanıcıya ait geçici bir klasör.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    XDG_RUNTIME_DIR="/tmp/xdg-runtime-$(id -u)"
    mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
    export XDG_RUNTIME_DIR
fi

in_group() {
    id -Gn | tr ' ' '\n' | grep -qx "$1"
}

if [ "$(uname -s)" = FreeBSD ]; then
    if [ ! -e /dev/dri/card0 ]; then
        problem "The graphics driver is not loaded (/dev/dri/card0 is missing)." \
            "Intel:  su -m root -c 'sysrc kld_list+=i915kms && kldload i915kms'" \
            "AMD:    su -m root -c 'sysrc kld_list+=amdgpu && kldload amdgpu'" \
            "(needs the drm-kmod package)"
    fi
    if [ ! -S /var/run/seatd.sock ]; then
        problem "seatd is not running (niri needs it to use the screen and keyboard)." \
            "su -m root -c 'sysrc seatd_enable=YES && service seatd start'"
    fi
    if ! in_group video; then
        problem "You are not in the 'video' group (needed to talk to seatd)." \
            "su -m root -c 'pw groupmod video -m $(id -un)'   then log out and back in"
    fi
    if ! service dbus onestatus >/dev/null 2>&1 && [ ! -S /var/run/dbus/system_bus_socket ]; then
        problem "The system D-Bus is not running (battery, drives and notifications need it)." \
            "su -m root -c 'sysrc dbus_enable=YES && service dbus start'"
    fi
fi

if ! command -v niri >/dev/null 2>&1; then
    problem "niri is not installed." "Run ~/dotfiles/install.sh"
fi

if [ "$problems" -gt 0 ]; then
    printf '\nniri-start: fix the problem(s) above, then run niri-start again.\n' >&2
    exit 1
fi

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/niri-session"
mkdir -p "$log_dir"
[ -f "$log_dir/niri.log" ] && mv -f "$log_dir/niri.log" "$log_dir/niri.log.old"
echo "Starting niri (log: $log_dir/niri.log)…"

if command -v niri-session >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    niri-session > "$log_dir/niri.log" 2>&1
elif command -v dbus-run-session >/dev/null 2>&1; then
    # İlk "--" ck-launch-session'ın kendi seçeneklerini bitirir; kalanı olduğu gibi geçer.
    if [ -z "${XDG_SESSION_COOKIE:-}" ] && command -v ck-launch-session >/dev/null 2>&1; then
        ck-launch-session -- dbus-run-session -- niri --session > "$log_dir/niri.log" 2>&1
    else
        dbus-run-session -- niri --session > "$log_dir/niri.log" 2>&1
    fi
else
    niri --session > "$log_dir/niri.log" 2>&1
fi
rc=$?
if [ "$rc" -ne 0 ]; then
    echo "niri exited with status $rc. Last lines of the log:" >&2
    tail -n 15 "$log_dir/niri.log" >&2
fi
exit "$rc"
