MARGIN_TOP = 110        # ekranın (panelin) üstünden uzaklık
DEBOUNCE = 110          # qalc ve plocate yazmayı bu kadar ms bekler
ACTION_DELAY = 180      # eylemlerden önce pencere kapansın (ekran görüntüsüne girmesin)
LIMITS = {"calc": 1, "apps": 6, "windows": 5, "actions": 6, "files": 7, "web": 2, "emoji": 60,
          "color": 3, "commands": 8, "timers": 10}
TITLES = {"calc": "Calculator", "apps": "Applications", "windows": "Windows",
          "actions": "Settings & actions", "files": "Files", "web": "Web", "emoji": "Emoji",
          "color": "Color", "commands": "Run a command", "timers": "Timers"}

