#!/usr/bin/python3
# launcher — Super+D: tek arama kutusu. Yazdıkça uygulamalar, açık pencereler, ayarlar ve
# eylemler, dosyalar, hesap makinesi ve web araması gelir; ":" ile başlayınca emoji.
#
#   launcher [toggle]    pencereyi aç/kapa
#   launcher daemon      arka planda bekleyen pencere (launcher.service)
#   launcher selftest    arayüzsüz arama mantığı testleri (check.sh)
#
# Pencere arka planda hazır bekler; tuşa basınca yalnızca görünür olur. Super+D bu betiği
# değil doğrudan TOGGLE komutunu çalıştırır: servise SIGUSR1 gönderir (~6 ms; Python'u
# başlatmak bile ~40 ms). Servis çalışmıyorsa fuzzel açılır.
#
# Kaynaklar:
#   uygulamalar    .desktop kayıtları; en çok/son açılanlar üstte (~/.local/state/launcher)
#   pencereler     niri msg windows; seçince o pencereye geçer
#   ayarlar        Settings sayfaları, tema, duvar kağıdı, monitör yeri, hızlı ayar düğmeleri,
#                  ekran görüntüsü, oturum (kilit, çıkış, yeniden başlat…)
#   dosyalar       son açılanlar (recently-used.xbel) + plocate dizini: yalnızca ev klasörü,
#                  gizli klasörler hariç. Dizin günde bir güncellenir (plocate-updatedb.timer).
#   hesap makinesi basit işlemler (2*(3+4)) Python'la anında; birim, kur, yüzde, fonksiyon
#                  (5 km to mi, 100 usd to eur, sqrt(2)) qalc ile. "=" ile başlamak zorlar.
#   emoji          ":smile" — IBus'un emoji listesi; seçilen kopyalanır
#   web            her sorgunun en altında; alan adı yazılırsa doğrudan açar
#
# Uzun yaşayan her şey (uygulamalar, kilit, wl-copy…) `niri msg action spawn` ile başlar:
# servisin cgroup'una girmesin, servis yeniden başlayınca kapanmasın.
# Ekrana yazılan her şey İngilizce (arayüz kuralı); açıklamalar Türkçe.

import ast
import json
import math
import operator
import os
import re
import sys
import time
import unicodedata
from pathlib import Path

HOME = os.path.expanduser("~")
# niri/binds.kdl'deki Super+D ile aynı komut.
TOGGLE = ("systemctl --user kill --kill-whom=main --signal=USR1 launcher.service 2>/dev/null"
          " || exec fuzzel")
USAGE = "usage: launcher [toggle] | daemon | selftest"

if __name__ == "__main__" and sys.argv[1:] in ([], ["toggle"]):
    os.execvp("sh", ["sh", "-c", TOGGLE])


# ── Arama mantığı (GTK'sız; selftest bunları dener) ───────────────────────

SPLIT = re.compile(r"[\W_]+")


def fold(text):
    """Büyük/küçük harf ve aksan farkını siler: 'İstanbul Ayarları' → 'istanbul ayarlari'."""
    text = (text or "").casefold().replace("ı", "i")
    return "".join(c for c in unicodedata.normalize("NFKD", text) if not unicodedata.combining(c))


def word_score(word, text):
    """Bir sorgu kelimesinin bir alana uyumu, 0..1."""
    if not text or not word:
        return 0.0
    if text == word:
        return 1.0
    if text.startswith(word):
        return 0.9
    i = text.find(word)
    if i < 0:
        return 0.0
    if not text[i - 1].isalnum():
        return 0.8                       # bir kelimenin başı
    return 0.55 if len(word) >= 2 else 0.0


def initials(text):
    return "".join(part[0] for part in SPLIT.split(text) if part)


def match(words, fields):
    """words: katlanmış kelimeler; fields: [(katlanmış metin, ağırlık)]. Hepsi eşleşmeli."""
    if not words:
        return 0.0
    total = 0.0
    for word in words:
        best = max((word_score(word, text) * weight for text, weight in fields), default=0.0)
        if not best:
            return 0.0
        total += best
    return total / len(words)


def name_match(words, name, fields):
    """match + baş harfler: 'vsc' → Visual Studio Code."""
    score = match(words, fields)
    if len(words) == 1 and len(words[0]) >= 2 and initials(name).startswith(words[0]):
        score = max(score, 0.75)
    return score


def frecency(entry, now):
    """[kaç kez, son zaman] → 0..30 puan; yakın zamanda kullanılan daha ağır."""
    if not entry:
        return 0.0
    count, last = entry
    age = now - last
    weight = 1.0 if age < 3 * 86400 else 0.7 if age < 14 * 86400 else 0.4
    return min(30.0, 10 * math.log2(1 + count)) * weight


# Hesap makinesi
ARITH = re.compile(r"[\d\s.+\-*/^()×÷]+")
NUMBER = re.compile(r"[-+]?\d+([.,]\d+)?")
OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
       ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod}
BASES = {"bin", "binary", "hex", "hexadecimal", "oct", "octal", "dec", "decimal", "duo",
         "roman", "base", "time", "fraction", "sci", "scientific", "utc", "bijective", "unicode"}


def calc_kind(query):
    """None | 'py' (anında) | 'qalc' (üstte gösterilir) | 'weak' (qalc, ama listenin altında)."""
    q = query.strip()
    if q.startswith("="):
        return "qalc" if q[1:].strip() else None
    if not re.search(r"\d", q) or NUMBER.fullmatch(q):
        return None
    if ARITH.fullmatch(q) and re.search(r"[\d)]\s*[-+*/^×÷]", q):
        return "py"
    if re.search(r"[-+*/^×÷%]|\bto\b|→|[a-z]\(", q, re.I):
        return "qalc"
    if re.search(r"\d\s*[^\W\d_]", q):
        return "weak"                     # "5 km", "2fa": belki birim, belki uygulama adı
    return None


def py_calc(query):
    expr = query.strip().replace("×", "*").replace("÷", "/").replace("^", "**")

    def ev(node):
        if isinstance(node, ast.Expression):
            return ev(node.body)
        if isinstance(node, ast.Constant) and type(node.value) in (int, float):
            return node.value
        if isinstance(node, ast.UnaryOp) and isinstance(node.op, (ast.UAdd, ast.USub)):
            value = ev(node.operand)
            return -value if isinstance(node.op, ast.USub) else value
        if isinstance(node, ast.BinOp):
            a, b = ev(node.left), ev(node.right)
            if isinstance(node.op, ast.Pow):
                if abs(b) > 1000 or (abs(a) > 10 and b > 300):
                    raise ValueError("too big")
                return a ** b
            return OPS[type(node.op)](a, b)
        raise ValueError("not arithmetic")

    try:
        value = ev(ast.parse(expr, mode="eval"))
    except (SyntaxError, ValueError, KeyError, TypeError, ZeroDivisionError, OverflowError):
        return None
    return fmt_number(value)


def fmt_number(value):
    if isinstance(value, complex):
        return None
    if isinstance(value, float):
        if math.isnan(value) or math.isinf(value):
            return None
        if value.is_integer() and abs(value) < 1e15:
            value = int(value)
    if isinstance(value, int):
        text = str(value)
        return text if len(text) <= 30 else f"{value:.10g}"
    return f"{value:.10g}"


def qalc_expr(query):
    """qalc'ın anlamadığı ya da karışık birimle (3 mi + 188 yd…) cevapladığı kalıpları düzeltir."""
    q = query.strip().lstrip("=").strip()
    q = re.sub(r"(\d)\s*%\s*of\b", r"\1% *", q, flags=re.I)

    def single_unit(m):
        target = m.group(2)
        return m.group(0) if target.lower() in BASES else f"{m.group(1)}-{target}"
    return re.sub(r"(\bto\s+)([^\W\d][\w°]*)", single_unit, q)


def qalc_result(query, output):
    """qalc çıktısından gösterilecek sonuç; anlamsızsa None."""
    lines = [line.strip() for line in (output or "").splitlines() if line.strip()]
    if not lines or any(line.lower().startswith(("error", "warning")) for line in lines):
        return None
    result = lines[-1]
    if len(result) >= 2 and result[0] == result[-1] == '"':
        result = result[1:-1]

    def norm(text):
        return re.sub(r"\s+", "", text.replace("−", "-")).casefold()
    if not result or norm(result) == norm(query.strip().lstrip("=")):
        return None                       # "2fa" → "2 fa": qalc yalnızca tekrar etti
    return result


# Web
TLDS = set("""com org net io dev app ai co de tr eu uk us ca fr it es nl ch at be se no dk fi
pl cz ru jp cn in br au info edu gov me tv gg xyz sh so to ly fm page site online tech blog
wiki""".split())
DOMAIN = re.compile(r"(?:[\w-]+\.)+([a-z]{2,})(?::\d+)?(?:/\S*)?", re.I)


def as_url(query):
    q = query.strip()
    if not q or " " in q:
        return None
    if re.match(r"https?://\S+$", q):
        return q
    m = DOMAIN.fullmatch(q)
    if m and m.group(1).lower() in TLDS:
        return "https://" + q
    return None


# Dosyalar
# Derleme/bağımlılık klasörleri: aramada yalnızca gürültü.
SKIP_DIRS = {"node_modules", "__pycache__", "site-packages", "dist-packages", "target", "build",
             "dist", "venv", "vendor", "Pods", "DerivedData"}


def rank_files(paths, words, recent, home, limit):
    """plocate çıktısı → [(puan, yol)]: ev klasöründe, gizli/gürültülü klasörler hariç."""
    seen, ranked = set(), []
    prefix = home.rstrip("/") + "/"
    for path in paths:
        if not path.startswith(prefix) or path in seen:
            continue
        seen.add(path)
        parts = path[len(prefix):].split("/")
        if any(p.startswith(".") or p in SKIP_DIRS for p in parts):
            continue
        name = fold(parts[-1])
        score = sum(word_score(w, name) for w in words) / max(len(words), 1) or 0.5
        bonus = (8 if path in recent else 0) - min(len(parts), 10) * 0.5
        ranked.append((score * 100 + bonus, path))
    ranked.sort(key=lambda r: (-r[0], len(r[1])))
    return ranked[:limit]


def window_app_keys(app_id):
    """niri app_id'sinden .desktop eşleştirme anahtarları."""
    a = (app_id or "").lower()
    return [k for k in (a, a.removesuffix(".desktop"), a.rsplit(".", 1)[-1]) if k]


def selftest():
    now = 1_000_000_000
    firefox = [(fold("Firefox"), 1.0), (fold("Web Browser"), 0.7), (fold("internet www"), 0.7)]
    vscode = [(fold("Visual Studio Code"), 1.0)]
    cases = [
        ("fold Turkish", fold("İstanbul AYARLARI ışık"), "istanbul ayarlari isik"),
        ("prefix > contains", match(["fir"], firefox) > match(["fox"], firefox) > 0, True),
        ("all words must match", match(["web", "fire"], firefox) > 0 and match(["web", "zzz"], firefox) == 0, True),
        ("no match", match(["xyz"], firefox), 0.0),
        ("initials", name_match(["vsc"], fold("Visual Studio Code"), vscode) >= 0.75, True),
        ("frecency recent > old", frecency([5, now - 3600], now) > frecency([5, now - 30 * 86400], now) > 0, True),
        ("frecency none", frecency(None, now), 0.0),
        ("calc py", calc_kind("2*(3+4)"), "py"),
        ("calc unit", calc_kind("5 km to mi"), "qalc"),
        ("calc currency", calc_kind("100 usd to eur"), "qalc"),
        ("calc func", calc_kind("sqrt(2)"), "qalc"),
        ("calc forced", calc_kind("=pi"), "qalc"),
        ("calc weak", calc_kind("2fa"), "weak"),
        ("calc app name", calc_kind("firefox"), None),
        ("calc lone number", calc_kind("2026"), None),
        ("calc mp3", calc_kind("mp3"), None),
        ("py 14", py_calc("2*(3+4)"), "14"),
        ("py third", py_calc("1/3"), "0.3333333333"),
        ("py caret", py_calc("2^10"), "1024"),
        ("py big int", py_calc("2^64"), "18446744073709551616"),
        ("py div0", py_calc("1/0"), None),
        ("py huge", py_calc("9^99999"), None),
        ("py float int", py_calc("0.5*4"), "2"),
        ("qalc single unit", qalc_expr("5 km to mi"), "5 km to -mi"),
        ("qalc base kept", qalc_expr("255 to hex"), "255 to hex"),
        ("qalc percent of", qalc_expr("17% of 250"), "17% * 250"),
        ("qalc forced", qalc_expr("= 2 pi"), "2 pi"),
        ("qalc result", qalc_result("5 km to mi", "3.106855961 mi\n"), "3.106855961 mi"),
        ("qalc echo hidden", qalc_result("2fa", "2 fa\n"), None),
        ("qalc symbolic hidden", qalc_result("x-2", "x − 2\n"), None),
        ("qalc quotes", qalc_result("today + 30 days", '"2026-12-04"\n'), "2026-12-04"),
        ("qalc error", qalc_result("1+", "error: oops\n1\n"), None),
        ("url domain", as_url("github.com/niri"), "https://github.com/niri"),
        ("url scheme", as_url("http://localhost:8000"), "http://localhost:8000"),
        ("url file ext", as_url("readme.md"), None),
        ("url words", as_url("foo bar.com"), None),
        ("files filtered/ranked", [p for _, p in rank_files(
            ["/h/Documents/report.pdf", "/h/.cache/report.pdf", "/h/x/node_modules/report.js",
             "/other/report.pdf", "/h/a/b/c/old-report.txt", "/h/Documents/report.pdf"],
            ["report"], set(), "/h", 5)], ["/h/Documents/report.pdf", "/h/a/b/c/old-report.txt"]),
        ("files recent first", rank_files(["/h/a/notes.md", "/h/b/notes.md"], ["notes"],
                                          {"/h/b/notes.md"}, "/h", 5)[0][1], "/h/b/notes.md"),
        ("window keys", window_app_keys("org.kde.dolphin"), ["org.kde.dolphin", "org.kde.dolphin", "dolphin"]),
    ]
    failed = [(name, got, want) for name, got, want in cases if got != want]
    for name, got, want in failed:
        print(f"FAIL {name}: got {got!r}, want {want!r}")
    if failed:
        sys.exit(1)
    print(f"launcher: {len(cases)} checks ok")


if __name__ == "__main__" and sys.argv[1:] == ["selftest"]:
    selftest()
    sys.exit(0)
if __name__ == "__main__" and sys.argv[1:] != ["daemon"]:
    sys.exit(USAGE)


