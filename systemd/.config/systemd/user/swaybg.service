# Duvar kağıdı (yalnızca niri oturumu).
# `theme swaybg` geçerli duvar kağıdını gösterir; duvar kağıdı yoksa temanın arka plan rengini.
# Duvar kağıdını değiştirmek için: theme wallpaper <dosya>

[Unit]
Description=Wallpaper for the niri session
PartOf=graphical-session.target
After=graphical-session.target theme-apply.service
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/theme swaybg
Restart=on-failure
