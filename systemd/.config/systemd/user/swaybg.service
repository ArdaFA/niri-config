# Duvar kağıdı (yalnızca niri oturumu).
# ~/.local/state/theme/wallpaper bağlantısı varsa onu gösterir, yoksa düz renk.
# ($$ = systemd'nin kendisinin değil, sh'nin değişkeni)

[Unit]
Description=Wallpaper for the niri session
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/bin/sh -c 'w="$$HOME/.local/state/theme/wallpaper"; if [ -e "$$w" ]; then exec swaybg --mode fill --image "$$w"; else exec swaybg --color 1d1a21; fi'
Restart=on-failure
