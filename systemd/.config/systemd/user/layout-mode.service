# Otomatik ızgara düzeni (AUTO) ve elle düzen (FREE) — yalnızca niri oturumu.
# niri'nin olaylarını dinler, pencereleri iki sütunlu ızgaraya dizer. Modu değiştirmek: Super+T
# ya da paneldeki AUTO/FREE etiketine tıkla. Ayrıntı: layout-mode --help
# Ayrıntılı günlük için: systemctl --user edit layout-mode → Environment=LAYOUT_MODE_DEBUG=1

[Unit]
Description=Automatic grid layout for the niri session (AUTO / FREE)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/layout-mode daemon
Restart=on-failure
RestartSec=1
