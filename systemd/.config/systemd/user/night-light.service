# Gece ışığı: ekran renklerini sıcak tona çeker (wlsunset). Oturum açılışında başlamaz;
# hızlı ayarlardaki "Night light" düğmesi ya da `night-light on` başlatır.
#
# -t düşük, -T yüksek sıcaklık. İkisi neredeyse aynı olduğu için ekran gün içinde de
# sıcak kalır (sabah/akşam saatleri -S/-s yalnızca wlsunset istediği için yazılı).
# Daha sıcak için -t'yi düşür (ör. 3500), -T hep bir fazlası olsun.
# Değiştirdikten sonra: systemctl --user daemon-reload && night-light off && night-light on
#
# /usr/bin/env: wlsunset kurulu olmasa da birim dosyası geçerli kalsın (check.sh).

[Unit]
Description=Night light for the niri session (wlsunset)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/env wlsunset -t 4000 -T 4001 -S 06:00 -s 18:00
Restart=on-failure
