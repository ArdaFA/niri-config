# Gece ışığı: ekran renklerini sıcak tona çeker (wlsunset). Hızlı ayarlardaki "Night light"
# düğmesi ya da `night-light on` başlatır. Settings → Displays → "Turn on automatically" açıksa
# night-light-auto.timer akşam 19:00'da başlatır, sabah 07:00'de durdurur.
#
# -t düşük, -T yüksek sıcaklık. İkisi neredeyse aynı olduğu için ekran gün içinde de
# sıcak kalır (sabah/akşam saatleri -S/-s yalnızca wlsunset istediği için yazılı).
# Sıcaklık: Settings uygulaması (Super+S → Displays → Warmth) ~/.local/state/settings/
# services.env'e yazar; buradaki Environment= satırı o dosya yokken geçerli varsayılandır.
#
# /usr/bin/env: wlsunset kurulu olmasa da birim dosyası geçerli kalsın (check.sh).

[Unit]
Description=Night light for the niri session (wlsunset)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Environment=NIGHT_TEMP=4000 NIGHT_TEMP_HIGH=4001
EnvironmentFile=-%S/settings/services.env
ExecStart=/usr/bin/env wlsunset -t ${NIGHT_TEMP} -T ${NIGHT_TEMP_HIGH} -S 06:00 -s 18:00
Restart=on-failure
