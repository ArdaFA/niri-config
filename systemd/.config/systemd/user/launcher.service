# Arama penceresi (Super+D) — yalnızca niri oturumu. Pencere arka planda hazır bekler,
# Super+D ona SIGUSR1 gönderir (niri/binds.kdl), böylece tuşa basınca anında açılır.
# Ayrıntı: README → Arama (Super+D)

[Unit]
Description=Search launcher for the niri session (Super+D)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/launcher daemon
Restart=on-failure
RestartSec=1
