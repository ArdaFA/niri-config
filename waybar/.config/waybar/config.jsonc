// Waybar — üst panel.
// Modül seçenekleri: man waybar-<modül>   (ör. man waybar-clock, man waybar-niri-workspaces)
//
// style.css ve tema renkleri değişince Waybar kendisi yenilenir (reload_style_on_change).
// Bu dosyayı değiştirdikten sonra: systemctl --user restart waybar
// (`reload`/SIGUSR2 kullanma: Waybar 0.14'te eski barları kapatmadan yenilerini açıyor
//  ve tepsi simgeleri yeni barlara gelmiyor.)
{
    "reload_style_on_change": true,

    // Ekranın üstüne yapışık, tam genişlikte (kenar boşluğu ve yuvarlak köşe yok).
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    // Sol: workspace'ler ve açıp kapattığın modlar (düzen, AWAKE, NIGHT, ECO/PERF, VPN).
    // Sağ: o an olup bitenler (MIC/CAM/SCR, FAIL, CPU/MEM/TEMP), medya, tepsi ve durum yazıları.
    // Modlar solda çünkü sağ yarı dolu; sol yarıda pencere başlığı gerekirse kısalır.
    "modules-left": [
        "niri/workspaces", "custom/layout",
        "custom/awake", "custom/night", "custom/power", "custom/vpn",
        "niri/window"
    ],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/privacy", "custom/failed", "custom/system",
        "group/media", "tray",
        "custom/mic", "wireplumber", "backlight", "network", "battery", "custom/notifications"
    ],

    // ── Sol ──────────────────────────────────────────────────────────────
    "niri/workspaces": {
        // Sadece bu monitörün workspace'leri, sıra numarasıyla.
        "format": "{index}"
    },

    // Düzen modu: AUTO (iki sütunlu otomatik ızgara) ya da FREE (dizme durur, elle ayarla).
    // layout-mode servisi mod değişince SIGRTMIN+8 gönderir, etiket yeniden okunur.
    "custom/layout": {
        "exec": "~/.local/bin/layout-mode label",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.local/bin/layout-mode toggle"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        // Bu bardaki monitörde odaktaki pencere (her monitör kendi başlığını gösterir).
        "separate-outputs": true,
        "icon": false,
        // Yazılmazsa Waybar 0.14 her barda "'swap-icon-label' must be a bool" uyarısı veriyor.
        "swap-icon-label": false
    },

    // ── Orta ─────────────────────────────────────────────────────────────
    "clock": {
        // Arayüz İngilizce; KDE'deki bölge ayarıyla aynı (en_US).
        "locale": "en_US.UTF-8",
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}",
        // Tıkla: takvim (tekrar tıkla, Esc ya da dışarı tıkla: kapanır).
        "on-click": "~/.local/bin/calendar-popup"
    },

    // ── Yalnızca gerektiğinde görünen göstergeler (sol: modlar, sağ: olaylar) ──
    // Hepsi boş metin yazınca gizlenir; normal bir anda bar bugünküyle aynı görünür.

    // MIC / CAM / SCR: mikrofon, kamera ya da ekran paylaşımı kullanılırken (kırmızı).
    // Üstüne gelince hangi uygulama olduğu görünür.
    "custom/privacy": {
        "exec": "~/.local/bin/bar-status privacy",
        "return-type": "json",
        "restart-interval": 10,
        "escape": true
    },

    // FAIL n: çökmüş bir servis var (kullanıcı ya da sistem). Üstüne gel: adları · tıkla: ayrıntı.
    // (Waybar'ın systemd-failed-units modülü bir kez gizlenince bir daha görünmüyor.)
    "custom/failed": {
        "exec": "~/.local/bin/bar-status failed",
        "return-type": "json",
        "restart-interval": 10,
        "escape": true,
        "on-click": "niri msg action spawn -- foot --hold --title 'Failed units' sh -c 'systemctl --failed; echo; systemctl --user --failed'"
    },

    // CPU / MEM / TEMP: yalnızca yük, bellek ya da sıcaklık 15 sn boyunca yüksek kalırsa
    // (eşikler: CPU %80, MEM %85, TEMP 85 °C; bar-status içinde). Kısa sıçramalarda yanıp sönmez.
    // Tıkla: GNOME System Monitor (işlemler).
    "custom/system": {
        "exec": "~/.local/bin/bar-status system",
        "return-type": "json",
        "restart-interval": 10,
        "on-click": "niri msg action spawn -- gnome-system-monitor --show-processes-tab"
    },

    // VPN: trafik bir VPN'den geçerken (Cisco, NetworkManager VPN/WireGuard, Tailscale exit node).
    // Tailscale'in kendisi hep açık olduğu için yalnızca exit node kullanılırken sayılır.
    "custom/vpn": {
        "exec": "~/.local/bin/bar-status vpn",
        "return-type": "json",
        "restart-interval": 10,
        "escape": true
    },

    // AWAKE: ekran açık tutuluyor (boşta kilit ve ekran kapatma yok). Hızlı ayarlar → Stay awake.
    // Tıkla: kapat. awake scripti durum değişince SIGRTMIN+9 gönderir.
    "custom/awake": {
        "exec": "~/.local/bin/awake label",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "~/.local/bin/awake off"
    },

    // NIGHT: gece ışığı açık (wlsunset). Hızlı ayarlar → Night light. Tıkla: kapat.
    // night-light scripti SIGRTMIN+10 gönderir; servis kendi kendine durursa 30 sn içinde güncellenir.
    "custom/night": {
        "exec-if": "command -v wlsunset",
        "exec": "~/.local/bin/night-light label",
        "return-type": "json",
        "interval": 30,
        "signal": 10,
        "on-click": "~/.local/bin/night-light off"
    },

    // ECO / PERF: güç profili "balanced" değilken. Tıkla: balanced'a dön.
    "custom/power": {
        "exec": "~/.local/bin/bar-status power",
        "return-type": "json",
        "restart-interval": 10,
        "on-click": "~/.local/bin/bar-status power reset"
    },

    // ── Sağ ──────────────────────────────────────────────────────────────
    // Medya: yalnızca bir çalar (müzik, video, tarayıcı) açıkken görünür.
    // |<  önceki · > / ||  oynat / duraklat · >|  sonraki · ♪ başlık (tıkla: oynat/duraklat)
    // Düğmeler `playerctl --follow` ile durumu izler: çalar kapanınca boş satır gelir,
    // Waybar modülü gizler. Hepsi en son kullanılan çaları hedefler (playerctld).
    "group/media": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "custom/media-play", "custom/media-next", "mpris"]
    },

    "custom/media-prev": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\"}'",
        "return-type": "json",
        "format": "|&lt;",
        "tooltip-format": "Previous",
        "on-click": "playerctl previous",
        "exec-on-event": false
    },

    "custom/media-play": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\",\"alt\":\"{{lc(status)}}\",\"class\":\"{{lc(status)}}\"}'",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "playing": "||",
            "paused": "&gt;",
            "stopped": "&gt;"
        },
        "tooltip-format": "Play / pause",
        "on-click": "playerctl play-pause",
        "exec-on-event": false
    },

    "custom/media-next": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\"}'",
        "return-type": "json",
        "format": "&gt;|",
        "tooltip-format": "Next",
        "on-click": "playerctl next",
        "exec-on-event": false
    },

    "mpris": {
        "format": "<span alpha='55%'>♪</span> {dynamic}",
        "format-stopped": "",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "dynamic-len": 40,
        // Bar kalabalıklaşınca önce medya başlığı kısalsın (… ile), NET/VOL gibi yazılar değil.
        // 42 = "♪ " + dynamic-len (40): sığdığı sürece hiçbir şey kesilmez.
        "max-length": 42,
        "tooltip-format": "{title}\n{artist}\nClick: controls · Middle: previous · Right: next",
        // Tıkla: başlığın altında küçük kontrol kutusu (media-popup). Tekrar tıkla: kapanır.
        "on-click": "~/.local/bin/media-popup --at-pointer"
    },

    // Etiketler retro metin; <span alpha> etiketi soluk, değeri parlak gösterir.
    // VOL / LCD / NET / BAT / MSG'ye tıklamak hızlı ayarlar ve bildirim panelini açar (swaync),
    // GNOME'un sağ üstteki durum simgeleri gibi.
    // MIC off: yalnızca mikrofon sessizdeyken görünür (görüşmelerde hatırlatma). Tıkla: aç.
    // (wireplumber modülü boş format'ta gizlenmediği için ayrı bir modül.)
    "custom/mic": {
        "exec": "~/.local/bin/bar-status mic",
        "return-type": "json",
        "restart-interval": 10,
        "on-click": "~/.local/bin/osd mic mute"
    },

    "wireplumber": {
        "format": "<span alpha='55%'>VOL</span> {volume}%",
        "format-muted": "<span alpha='55%'>VOL</span> --",
        "scroll-step": 5,
        "max-volume": 100,
        "tooltip-format": "{node_name}: {volume}%",
        "on-click": "swaync-client --toggle-panel --skip-wait",
        "on-click-middle": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // LCD: ekran parlaklığı. Tekerlek: değiştir (parlaklık tuşları gibi gösterge açar).
    "backlight": {
        "device": "intel_backlight",
        "format": "<span alpha='55%'>LCD</span> {percent}%",
        "tooltip": false,
        "on-scroll-up": "~/.local/bin/osd brightness up",
        "on-scroll-down": "~/.local/bin/osd brightness down",
        "on-click": "swaync-client --toggle-panel --skip-wait"
    },

    "network": {
        "format-wifi": "<span alpha='55%'>NET</span> {essid}",
        "format-ethernet": "<span alpha='55%'>NET</span> eth",
        "format-linked": "<span alpha='55%'>NET</span> ...",
        "format-disconnected": "<span alpha='55%'>NET</span> off",
        "max-length": 28,
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}  {ifname}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}  {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "swaync-client --toggle-panel --skip-wait",
        "on-click-right": "nm-connection-editor"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "<span alpha='55%'>BAT</span> {capacity}%",
        "format-charging": "<span alpha='55%'>CHG</span> {capacity}%",
        "format-plugged": "<span alpha='55%'>AC</span> {capacity}%",
        "format-full": "<span alpha='55%'>AC</span> full",
        "format-time": "{H}h {M}m",
        "tooltip-format": "{capacity}%  {time}",
        "on-click": "swaync-client --toggle-panel --skip-wait"
    },

    // Bildirimler (swaync). MSG: geçmiş boş · MSG •: okunmamış bildirim var ·
    // DND: Rahatsız Etme açık. Tıkla: panel · sağ tık: Rahatsız Etme aç/kapa.
    // swaync kurulu değilse (mako yedekte) modül görünmez.
    "custom/notifications": {
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client --subscribe-waybar",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "none": "MSG",
            "notification": "MSG •",
            "dnd-none": "DND",
            "dnd-notification": "DND •",
            "inhibited-none": "MSG",
            "inhibited-notification": "MSG •",
            "dnd-inhibited-none": "DND",
            "dnd-inhibited-notification": "DND •"
        },
        "on-click": "swaync-client --toggle-panel --skip-wait",
        "on-click-right": "swaync-client --toggle-dnd --skip-wait",
        "escape": true
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
