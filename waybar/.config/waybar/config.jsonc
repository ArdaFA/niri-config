// Waybar — üst panel.
// Modül seçenekleri: man waybar-<modül>   (ör. man waybar-clock, man waybar-niri-workspaces)
//
// style.css ve tema renkleri değişince Waybar kendisi yenilenir (reload_style_on_change).
// Bu dosyayı değiştirdikten sonra: systemctl --user restart waybar
// (`reload`/SIGUSR2 kullanma: Waybar 0.14'te eski barları kapatmadan yenilerini açıyor
//  ve tepsi simgeleri yeni barlara gelmiyor.)
{
    "reload_style_on_change": true,

    // Ekranın üstüne yapışık, tam genişlikte (kenar boşluğu ve yuvarlak köşe yok).
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["niri/workspaces", "custom/layout", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["group/media", "tray", "wireplumber", "network", "battery"],

    // ── Sol ──────────────────────────────────────────────────────────────
    "niri/workspaces": {
        // Sadece bu monitörün workspace'leri, sıra numarasıyla.
        "format": "{index}"
    },

    // Düzen modu: AUTO (iki sütunlu otomatik ızgara) ya da FREE (dizme durur, elle ayarla).
    // layout-mode servisi mod değişince SIGRTMIN+8 gönderir, etiket yeniden okunur.
    "custom/layout": {
        "exec": "~/.local/bin/layout-mode label",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.local/bin/layout-mode toggle"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60,
        // Bu bardaki monitörde odaktaki pencere (her monitör kendi başlığını gösterir).
        "separate-outputs": true,
        "icon": false,
        // Yazılmazsa Waybar 0.14 her barda "'swap-icon-label' must be a bool" uyarısı veriyor.
        "swap-icon-label": false
    },

    // ── Orta ─────────────────────────────────────────────────────────────
    "clock": {
        // Arayüz İngilizce; KDE'deki bölge ayarıyla aynı (en_US).
        "locale": "en_US.UTF-8",
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}",
        // Tıkla: takvim (tekrar tıkla, Esc ya da dışarı tıkla: kapanır).
        "on-click": "~/.local/bin/calendar-popup"
    },

    // ── Sağ ──────────────────────────────────────────────────────────────
    // Medya: yalnızca bir çalar (müzik, video, tarayıcı) açıkken görünür.
    // |<  önceki · > / ||  oynat / duraklat · >|  sonraki · ♪ başlık (tıkla: oynat/duraklat)
    // Düğmeler `playerctl --follow` ile durumu izler: çalar kapanınca boş satır gelir,
    // Waybar modülü gizler. Hepsi en son kullanılan çaları hedefler (playerctld).
    "group/media": {
        "orientation": "horizontal",
        "modules": ["custom/media-prev", "custom/media-play", "custom/media-next", "mpris"]
    },

    "custom/media-prev": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\"}'",
        "return-type": "json",
        "format": "|&lt;",
        "tooltip-format": "Previous",
        "on-click": "playerctl previous",
        "exec-on-event": false
    },

    "custom/media-play": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\",\"alt\":\"{{lc(status)}}\",\"class\":\"{{lc(status)}}\"}'",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "playing": "||",
            "paused": "&gt;",
            "stopped": "&gt;"
        },
        "tooltip-format": "Play / pause",
        "on-click": "playerctl play-pause",
        "exec-on-event": false
    },

    "custom/media-next": {
        "exec": "playerctl --follow status --format '{\"text\":\"{{status}}\"}'",
        "return-type": "json",
        "format": "&gt;|",
        "tooltip-format": "Next",
        "on-click": "playerctl next",
        "exec-on-event": false
    },

    "mpris": {
        "format": "<span alpha='55%'>♪</span> {dynamic}",
        "format-stopped": "",
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "dynamic-len": 40,
        "tooltip-format": "{title}\n{artist}\nClick: play / pause · Middle: previous · Right: next",
        "on-click": "playerctl play-pause"
    },

    // Etiketler retro metin; <span alpha> etiketi soluk, değeri parlak gösterir.
    "wireplumber": {
        "format": "<span alpha='55%'>VOL</span> {volume}%",
        "format-muted": "<span alpha='55%'>VOL</span> --",
        "scroll-step": 5,
        "max-volume": 100,
        "tooltip-format": "{node_name}: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "network": {
        "format-wifi": "<span alpha='55%'>NET</span> {essid}",
        "format-ethernet": "<span alpha='55%'>NET</span> eth",
        "format-linked": "<span alpha='55%'>NET</span> ...",
        "format-disconnected": "<span alpha='55%'>NET</span> off",
        "max-length": 28,
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}  {ifname}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr}  {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "<span alpha='55%'>BAT</span> {capacity}%",
        "format-charging": "<span alpha='55%'>CHG</span> {capacity}%",
        "format-plugged": "<span alpha='55%'>AC</span> {capacity}%",
        "format-full": "<span alpha='55%'>AC</span> full",
        "format-time": "{H}h {M}m",
        "tooltip-format": "{capacity}%  {time}"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
